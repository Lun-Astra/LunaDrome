<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <!-- Android is opt-in (-p:EnableAndroid=true, see .github/workflows/android.yml): as a
         default target it would make every desktop build restore the Android workload/runtime
         packs too, which the Windows/Linux release runners (and a plain desktop dev setup) lack. -->
    <TargetFrameworks Condition="'$(EnableAndroid)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <!-- iOS likewise (-p:EnableIos=true, .github/workflows/ios.yml on a Mac runner): an unsigned
         .ipa for sideloading with AltStore / SideStore. -->
    <TargetFrameworks Condition="'$(EnableIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>LunaDrome</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.lunastra.lunadrome</ApplicationId>
    <!-- AndroidX Media (Android Auto, #26) needs Android 6+. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android'))">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios'))">15.0</SupportedOSPlatformVersion>
    <!-- Android launcher icon / splash: the moon from Assets/Icons + Assets/Splash on the app's dark background. -->
    <UnoIconBackgroundColor>#141517</UnoIconBackgroundColor>
    <UnoSplashScreenColor>#141517</UnoSplashScreenColor>
    <!-- Versions -->
    <ApplicationDisplayVersion>4.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>LunaDrome</ApplicationPublisher>
    <!-- Package Description -->
    <Description>LunaDrome powered by Uno Platform.</Description>
    <!-- The LunaDrome moon icon (carried over from the retired WPF app) for the .exe itself,
         so Explorer / the desktop shortcut show it. The window/taskbar icon is set at startup
         in App.xaml.cs from the same file. -->
    <ApplicationIcon>Assets\lunadrome.ico</ApplicationIcon>
    <!-- The Debug (test) build gets the orange variant, so it can't be mistaken for the installed app. -->
    <ApplicationIcon Condition="'$(Configuration)' == 'Debug'">Assets\lunadrome-test.ico</ApplicationIcon>

    <!-- Services/SmtcMediaControls.cs calls the WinRT media-flyout COM interfaces through raw vtables. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      SkiaRenderer;
      MediaPlayerElement;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LunaDrome.Core\LunaDrome.Core.csproj" />
  </ItemGroup>

  <!-- -p:SwipeTrace=true (the Android emulator UI test): log every swipe touch event to logcat. -->
  <PropertyGroup Condition="'$(SwipeTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);SWIPE_TRACE</DefineConstants>
  </PropertyGroup>

  <!-- The visualizer's audio capture (WASAPI loopback / PulseAudio) is desktop-only. On
       phones a no-op LoopbackCapture.Phone.cs takes its place (no visualizer there yet). -->
  <ItemGroup Condition="$(TargetFramework.Contains('desktop'))">
    <PackageReference Include="NAudio.Wasapi" />
    <Compile Remove="Services\LoopbackCapture.Phone.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('desktop'))">
    <Compile Remove="Services\LoopbackCapture.cs" />
    <!-- Linux media keys over D-Bus (Tmds.DBus comes with Uno's desktop runtime only). -->
    <Compile Remove="Services\MprisMediaControls.cs" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <!-- MediaSessionCompat / MediaBrowserServiceCompat: notification controls + Android Auto (#26). -->
    <PackageReference Include="Xamarin.AndroidX.Media" />
  </ItemGroup>

  <!-- The Uno SDK doesn't stamp a version into the assembly, so embed the display version as
       metadata: the built-in updater (Services/UpdateChecker.cs) compares it with GitHub's latest. -->
  <ItemGroup>
    <AssemblyMetadata Include="AppVersion" Value="$(ApplicationDisplayVersion)" />
  </ItemGroup>

  <!-- The LibVLC package drops native libs + plugins for every Windows architecture into
       libvlc/win-x64, win-x86 and win-arm64 (~280MB). A published app only ever loads the one
       matching its own runtime, and on Linux none of them (it uses the system's libvlc), so
       delete the rest after publish: -180MB on Windows, -280MB on Linux. -->
  <Target Name="TrimLibVlcForRuntime" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != '' And Exists('$(PublishDir)libvlc')">
    <ItemGroup>
      <_LibVlcArchDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)libvlc'))" />
      <_LibVlcArchDirToRemove Include="@(_LibVlcArchDir)" Condition="'%(Filename)' != '$(RuntimeIdentifier)'" />
    </ItemGroup>
    <RemoveDir Directories="@(_LibVlcArchDirToRemove)" />
    <Message Importance="high" Text="Trimmed LibVLC folders not needed for $(RuntimeIdentifier): @(_LibVlcArchDirToRemove->'%(Filename)')" />
  </Target>

</Project>
