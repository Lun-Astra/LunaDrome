<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>LunaDrome</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.lunadrome</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>2.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>LunaDrome</ApplicationPublisher>
    <!-- Package Description -->
    <Description>LunaDrome powered by Uno Platform.</Description>
    <!-- The LunaDrome moon icon (carried over from the retired WPF app) for the .exe itself,
         so Explorer / the desktop shortcut show it. The window/taskbar icon is set at startup
         in App.xaml.cs from the same file. -->
    <ApplicationIcon>Assets\lunadrome.ico</ApplicationIcon>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      SkiaRenderer;
      MediaPlayerElement;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LunaDrome.Core\LunaDrome.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <!-- The LibVLC package drops native libs + plugins for every Windows architecture into
       libvlc/win-x64, win-x86 and win-arm64 (~280MB). A published app only ever loads the one
       matching its own runtime, and on Linux none of them (it uses the system's libvlc), so
       delete the rest after publish: -180MB on Windows, -280MB on Linux. -->
  <Target Name="TrimLibVlcForRuntime" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != '' And Exists('$(PublishDir)libvlc')">
    <ItemGroup>
      <_LibVlcArchDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)libvlc'))" />
      <_LibVlcArchDirToRemove Include="@(_LibVlcArchDir)" Condition="'%(Filename)' != '$(RuntimeIdentifier)'" />
    </ItemGroup>
    <RemoveDir Directories="@(_LibVlcArchDirToRemove)" />
    <Message Importance="high" Text="Trimmed LibVLC folders not needed for $(RuntimeIdentifier): @(_LibVlcArchDirToRemove->'%(Filename)')" />
  </Target>

</Project>
