<Page x:Class="LunaDrome.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LunaDrome"
      xmlns:us="using:Uno.Simple"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <DataTemplate x:Key="AlbumCardTemplate">
      <StackPanel Width="140" Margin="0,0,16,16" Tapped="AlbumCard_Tapped" Tag="{Binding}">
        <Grid Width="140" Height="140" CornerRadius="6" Background="#2A2A2A">
          <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill"/>
        </Grid>
        <TextBlock Text="{Binding Name}" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding ArtistName}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TrackRowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding ArtistName}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="12" Opacity="0.6"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GenreRowTemplate">
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <TextBlock Text="{Binding Name}" FontSize="14"/>
        <TextBlock Text="{Binding AlbumCount}" FontSize="12" Opacity="0.6" Margin="8,0,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <!-- Login -->
    <StackPanel x:Name="LoginPanel"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="320" Spacing="10">
      <TextBlock Text="LunaDrome" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
      <TextBlock Text="Server URL"/>
      <TextBox x:Name="ServerUrlBox" Text="http://"/>
      <TextBlock Text="Username"/>
      <TextBox x:Name="UsernameBox"/>
      <TextBlock Text="Password"/>
      <PasswordBox x:Name="PasswordBox"/>
      <CheckBox x:Name="RememberMeBox" Content="Remember me" IsChecked="True"/>
      <Button x:Name="LoginButton" Content="Sign in" Click="LoginButton_Click"
              HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
      <TextBlock x:Name="StatusText" Foreground="OrangeRed" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Main shell: sidebar + content + playback bar -->
    <Grid x:Name="LibraryPanel" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#141414" Padding="16" Spacing="4">
          <TextBlock Text="LUNADROME" FontSize="12" FontWeight="Bold" Margin="0,0,0,16" Opacity="0.7"/>
          <Button x:Name="NavHomeButton" Content="Home" Tag="Home" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="NavArtistsButton" Content="Artists" Tag="Artists" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="NavAlbumsButton" Content="Albums" Tag="Albums" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="NavTracksButton" Content="Tracks" Tag="Tracks" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="NavGenresButton" Content="Genres" Tag="Genres" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>

          <Grid Margin="0,20,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PLAYLISTS" FontSize="12" FontWeight="Bold" Opacity="0.7" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+" Width="28" Height="28" Padding="0" Click="NewPlaylist_Click"/>
          </Grid>
          <ListView x:Name="PlaylistsList" IsItemClickEnabled="True" ItemClick="PlaylistRow_ItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,4"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24">

          <!-- Home: recently added albums -->
          <Grid x:Name="HomePanel" Visibility="Visible">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Recently Added" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
            <GridView Grid.Row="1" x:Name="HomeAlbumsList" ItemTemplate="{StaticResource AlbumCardTemplate}"/>
          </Grid>

          <!-- Artists list -->
          <Grid x:Name="ArtistsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Spacing="12">
              <TextBlock Text="Artists" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBox x:Name="ArtistSearchBox" PlaceholderText="Search artists" Width="220" TextChanged="ArtistSearchBox_TextChanged"/>
            </StackPanel>
            <ListView Grid.Row="1" x:Name="ArtistsList" Tapped="ArtistRow_Tapped">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,4" Tag="{Binding}">
                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                    <TextBlock Text="{Binding AlbumCount}" FontSize="12" Opacity="0.6" Margin="8,0,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <!-- Artist detail: header + their albums -->
          <Grid x:Name="ArtistDetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Spacing="12">
              <Button x:Name="ArtistBackButton" Content="&lt; Back" Click="ArtistBack_Click"/>
              <TextBlock x:Name="ArtistDetailHeader" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button x:Name="ArtistFavoriteButton" Content="☆" Click="ArtistFavoriteButton_Click"/>
            </StackPanel>
            <GridView Grid.Row="1" x:Name="ArtistAlbumsList" ItemTemplate="{StaticResource AlbumCardTemplate}"/>
          </Grid>

          <!-- Albums: whole library -->
          <Grid x:Name="AlbumsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Spacing="12">
              <TextBlock Text="Albums" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBox x:Name="AllAlbumsSearchBox" PlaceholderText="Search albums" Width="220" TextChanged="AllAlbumsSearchBox_TextChanged"/>
            </StackPanel>
            <GridView Grid.Row="1" x:Name="AllAlbumsList" ItemTemplate="{StaticResource AlbumCardTemplate}"/>
          </Grid>

          <!-- Album detail: header + tracks -->
          <Grid x:Name="AlbumDetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Spacing="12">
              <Button x:Name="AlbumBackButton" Content="&lt; Back" Click="AlbumBack_Click"/>
              <TextBlock x:Name="AlbumDetailHeader" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <ListView Grid.Row="1" x:Name="AlbumTracksList" ItemTemplate="{StaticResource TrackRowTemplate}"
                      IsItemClickEnabled="True" ItemClick="TrackList_ItemClick"/>
          </Grid>

          <!-- Tracks: whole library -->
          <Grid x:Name="TracksPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Spacing="12">
              <TextBlock Text="Tracks" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBox x:Name="AllTracksSearchBox" PlaceholderText="Search tracks" Width="220" TextChanged="AllTracksSearchBox_TextChanged"/>
            </StackPanel>
            <ListView Grid.Row="1" x:Name="TracksList" ItemTemplate="{StaticResource TrackRowTemplate}"
                      IsItemClickEnabled="True" ItemClick="TrackList_ItemClick"/>
          </Grid>

          <!-- Playlist detail -->
          <Grid x:Name="PlaylistDetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Spacing="12">
              <TextBlock x:Name="PlaylistDetailHeader" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="Delete playlist" Click="DeletePlaylist_Click"/>
            </StackPanel>
            <ListView Grid.Row="1" x:Name="PlaylistTracksList" ItemTemplate="{StaticResource TrackRowTemplate}"
                      IsItemClickEnabled="True" ItemClick="TrackList_ItemClick"/>
          </Grid>

          <!-- Genres list -->
          <Grid x:Name="GenresPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Genres" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
            <ListView Grid.Row="1" x:Name="GenresList" ItemTemplate="{StaticResource GenreRowTemplate}"
                      IsItemClickEnabled="True" ItemClick="GenreRow_ItemClick"/>
          </Grid>

          <!-- Genre detail: albums in that genre -->
          <Grid x:Name="GenreDetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" Spacing="12">
              <Button Content="&lt; Back" Click="GenreBack_Click"/>
              <TextBlock x:Name="GenreDetailHeader" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <GridView Grid.Row="1" x:Name="GenreAlbumsList" ItemTemplate="{StaticResource AlbumCardTemplate}"/>
          </Grid>

        </Grid>

        <!-- Lyrics overlay -->
        <Grid x:Name="LyricsPanel" Grid.Column="1" Visibility="Collapsed"
              Background="#1E1E1E" Width="320" HorizontalAlignment="Right" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16" Spacing="12">
            <TextBlock Text="Lyrics" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="✕" Click="CloseLyrics_Click"/>
          </StackPanel>
          <ListView Grid.Row="1" x:Name="LyricsList" Margin="16,0,16,16">
            <ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Grid>

      <!-- Playback bar -->
      <Grid Grid.Row="1" Padding="16,10" Background="#1A1A1A">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="NowPlayingText" Grid.Column="0" Text="Nothing playing"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="ShuffleButton" Content="Shuffle" Click="ShuffleButton_Click" Width="70"/>
          <Button x:Name="PreviousButton" Content="Prev" Click="PreviousButton_Click" Width="55"/>
          <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPauseButton_Click" Width="60"/>
          <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" Width="55"/>
          <Button x:Name="NextButton" Content="Next" Click="NextButton_Click" Width="55"/>
          <Button x:Name="RepeatButton" Content="Repeat: Off" Click="RepeatButton_Click" Width="90"/>
          <Button x:Name="FavoriteButton" Content="☆ Fav" Click="FavoriteButton_Click" Width="70"/>
          <Button x:Name="AddToPlaylistButton" Content="+ Playlist" Click="AddToPlaylistButton_Click" Width="90"/>
          <Button x:Name="LyricsButton" Content="Lyrics" Click="LyricsButton_Click" Width="70"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
          <TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center" Width="40"/>
          <Slider x:Name="ProgressSlider" Width="200" Minimum="0" Maximum="1"
                  PointerCaptureLost="ProgressSlider_PointerCaptureLost"/>
          <TextBlock x:Name="DurationText" Text="0:00" VerticalAlignment="Center" Width="40"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Vol" VerticalAlignment="Center"/>
          <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="80"
                  ValueChanged="VolumeSlider_ValueChanged"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
