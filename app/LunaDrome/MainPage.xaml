<Page x:Class="LunaDrome.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LunaDrome"
      xmlns:controls="using:LunaDrome.Controls"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      FontFamily="{StaticResource AppFont}"
      Background="{StaticResource BackgroundBrush}">

  <!-- 1:1 port of the WPF app's MainWindow.xaml (src/Musicplayer.App/MainWindow.xaml): same grid
       sizes, margins, font sizes, corner radii and page structure. Differences are only where
       WinUI has no equivalent (no BlurEffect - see BlurredArt; no GridView headers - see
       TrackListHeader; no triggers - see Motion / App.xaml visual states). -->
  <Page.Resources>
    <!-- Settings page: one card per section, grey explanation under each option. -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="20,16"/>
    </Style>
    <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="28,0,0,0"/>
    </Style>
    <controls:TrackColumnLayout x:Key="TrackColumns"/>
    <controls:FormatConverter x:Key="Format"/>

    <controls:FavoriteFillConverter x:Key="FavoriteFill"/>

    <controls:HomeLayout x:Key="HomeLayout"/>
    <controls:GenreColorConverter x:Key="GenreColor"/>

    <!-- Home album card, Feishin's look: square art that fills its share of the row (size from
         HomeLayout), 14px semibold album link, 13px gray artist link and year. -->
    <DataTemplate x:Key="HomeAlbumCardTemplate">
      <StackPanel Width="{Binding CardWidth, Source={StaticResource HomeLayout}}" Background="Transparent"
                  Tag="{Binding}" Tapped="AlbumCard_Tapped">
        <Grid Width="{Binding CardWidth, Source={StaticResource HomeLayout}}"
              Height="{Binding CardWidth, Source={StaticResource HomeLayout}}">
          <Border CornerRadius="6" Background="{StaticResource RaisedBrush}">
            <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border CornerRadius="6" Background="#80000000" controls:Motion.HoverFade="True">
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Tag="{Binding}" Tapped="AlbumPlayOverlay_Tapped" controls:Motion.HoverScale="1.08"
                    ToolTipService.ToolTip="Play">
              <Polygon Points="0,0 14,9 0,18" Fill="{StaticResource OnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </Border>
          </Border>
        </Grid>
        <Border Background="Transparent" Margin="0,10,0,0" HorizontalAlignment="Left"
                controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardAlbumText_Tapped">
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     MaxWidth="{Binding CardWidth, Source={StaticResource HomeLayout}}"/>
        </Border>
        <Border Background="Transparent" Margin="0,3,0,0" HorizontalAlignment="Left"
                controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardArtistText_Tapped">
          <TextBlock Text="{Binding ArtistName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" MaxWidth="{Binding CardWidth, Source={StaticResource HomeLayout}}"/>
        </Border>
        <TextBlock Text="{Binding Year}" FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
      </StackPanel>
    </DataTemplate>


    <!-- Album cards, Feishin-style interaction: the album name is a link to the album page and
         the artist name a link to the artist page (both turn white + underlined on hover, with a
         hand cursor); clicking the cover also opens the album; the round button in the hover
         overlay plays it. Sizes stay the WPF app's (small: 112/104, large: 152/140). -->
    <DataTemplate x:Key="AlbumCardTemplate">
      <StackPanel Width="112" Margin="2,4" Background="Transparent" Tag="{Binding}"
                  Tapped="AlbumCard_Tapped" controls:Motion.HoverScale="1.035">
        <Grid Width="104" Height="104" HorizontalAlignment="Left">
          <Border CornerRadius="8" Background="{StaticResource RaisedBrush}">
            <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border CornerRadius="8" Background="#99000000" controls:Motion.HoverFade="True">
            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Tag="{Binding}" Tapped="AlbumPlayOverlay_Tapped" controls:Motion.HoverScale="1.08"
                    ToolTipService.ToolTip="Play">
              <Polygon Points="0,0 10,6 0,12" Fill="{StaticResource OnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </Border>
          </Border>
        </Grid>
        <Border Background="Transparent" Margin="2,6,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardAlbumText_Tapped">
          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="104"/>
        </Border>
        <Border Background="Transparent" Margin="2,1,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardArtistText_Tapped">
          <TextBlock Text="{Binding ArtistName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="104"/>
        </Border>
        <TextBlock Text="{Binding Year}" FontSize="11" Margin="2,1,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LargeAlbumCardTemplate">
      <StackPanel Width="152" Margin="5,8" Background="Transparent" Tag="{Binding}"
                  Tapped="AlbumCard_Tapped" controls:Motion.HoverScale="1.035">
        <Grid Width="140" Height="140" HorizontalAlignment="Left">
          <Border CornerRadius="9" Background="{StaticResource RaisedBrush}">
            <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border CornerRadius="9" Background="#99000000" controls:Motion.HoverFade="True">
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Tag="{Binding}" Tapped="AlbumPlayOverlay_Tapped" controls:Motion.HoverScale="1.08"
                    ToolTipService.ToolTip="Play">
              <Polygon Points="0,0 13,8 0,16" Fill="{StaticResource OnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </Border>
          </Border>
        </Grid>
        <Border Background="Transparent" Margin="2,8,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardAlbumText_Tapped">
          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
        </Border>
        <Border Background="Transparent" Margin="2,2,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardArtistText_Tapped">
          <TextBlock Text="{Binding ArtistName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
        </Border>
        <TextBlock Text="{Binding Year}" FontSize="11" Margin="2,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
      </StackPanel>
    </DataTemplate>

    <!-- Search results: artist as a round photo + name. -->
    <DataTemplate x:Key="SearchArtistTemplate">
      <StackPanel Width="120" Margin="5,8" Background="Transparent" Tag="{Binding}" Tapped="SearchArtist_Tapped"
                  controls:Motion.HoverScale="1.035">
        <Border Width="100" Height="100" CornerRadius="50" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Center">
          <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="116"/>
      </StackPanel>
    </DataTemplate>

    <!-- "Download via SpotiDrome": a YouTube Music song / YouTube video with a Download button. -->
    <DataTemplate x:Key="YtTrackTemplate">
      <Grid Margin="0,4" Padding="8,6" CornerRadius="6" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="64" Height="36" CornerRadius="4" Margin="0,0,12,0" Background="{StaticResource RaisedBrush}">
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="12,0"/>
        <Button Grid.Column="3" Content="Download" Style="{StaticResource TextButtonStyle}" Tag="{Binding}" Click="YtTrackDownload_Click" VerticalAlignment="Center"
                ToolTipService.ToolTip="Download this song into your library via SpotiDrome"/>
      </Grid>
    </DataTemplate>

    <!-- "Download via SpotiDrome": a YouTube Music album card (click to see its tracks). -->
    <!-- A Button (not a Tapped panel) so it also works from the keyboard / screen readers. -->
    <DataTemplate x:Key="YtAlbumCardTemplate">
      <Button Width="152" Margin="5,8" Padding="0" Background="Transparent" BorderThickness="0"
              HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
              Tag="{Binding}" Click="YtAlbum_Click" AutomationProperties.Name="{Binding Title}" controls:Motion.HoverScale="1.035">
        <StackPanel>
          <Border Width="140" Height="140" CornerRadius="9" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Left">
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="140" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,2,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140" HorizontalAlignment="Left"/>
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- Track of a YouTube Music album being previewed before download. -->
    <DataTemplate x:Key="YtAlbumTrackTemplate">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TrackNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="12,0,4,0"/>
      </Grid>
    </DataTemplate>

    <!-- Downloads page row: label, status line, progress. -->
    <DataTemplate x:Key="DownloadRowTemplate">
      <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="8" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Value="{Binding Progress}" Maximum="1" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,4,0,0"
                         Visibility="{Binding ProgressVisibility}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Content="{Binding ActionText}" Style="{StaticResource TextButtonStyle}" Tag="{Binding}" Click="DownloadAction_Click" Visibility="{Binding ActionVisibility}"/>
            <Button Content="Cancel" Style="{StaticResource TextButtonStyle}" Tag="{Binding}" Click="DownloadCancel_Click" Visibility="{Binding CancelVisibility}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Artist page album card, Feishin's size: 172px square art, 14/13px text. -->
    <DataTemplate x:Key="FeishinAlbumCardTemplate">
      <StackPanel Width="172" Margin="0,0,12,20" Background="Transparent" Tag="{Binding}"
                  Tapped="AlbumCard_Tapped">
        <Grid Width="172" Height="172">
          <Border CornerRadius="6" Background="{StaticResource RaisedBrush}">
            <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border CornerRadius="6" Background="#80000000" controls:Motion.HoverFade="True">
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Tag="{Binding}" Tapped="AlbumPlayOverlay_Tapped" controls:Motion.HoverScale="1.08"
                    ToolTipService.ToolTip="Play">
              <Polygon Points="0,0 14,9 0,18" Fill="{StaticResource OnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </Border>
          </Border>
        </Grid>
        <Border Background="Transparent" Margin="0,10,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardAlbumText_Tapped">
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="172"/>
        </Border>
        <Border Background="Transparent" Margin="0,3,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="CardArtistText_Tapped">
          <TextBlock Text="{Binding ArtistName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="172"/>
        </Border>
        <TextBlock Text="{Binding Year}" FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
      </StackPanel>
    </DataTemplate>

    <!-- Album page track row (Feishin): # / TITLE / duration / heart. -->
    <DataTemplate x:Key="AlbumTrackRowTemplate">
      <Border Height="40" CornerRadius="4" Background="Transparent" Tag="{Binding}"
              controls:Motion.HoverBackground="{StaticResource RaisedBrush}"
              DoubleTapped="AlbumTrackRow_DoubleTapped" RightTapped="AlbumTrackRow_RightTapped">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="60"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Track}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Grid Grid.Column="3" Background="Transparent" Tag="{Binding}" Tapped="TrackFavorite_Tapped"
                ToolTipService.ToolTip="Favorite">
            <Path Width="15" Height="14" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                  Fill="{Binding IsFavorited, Converter={StaticResource FavoriteFill}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M8,15 C8,15 1,10.5 1,5.8 C1,3 3,1.3 5.4,1.3 C6.9,1.3 7.7,2.1 8,2.6 C8.3,2.1 9.1,1.3 10.6,1.3 C13,1.3 15,3 15,5.8 C15,10.5 8,15 8,15 Z"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>


    <!-- Track row: TITLE (40px art + title + clickable artist) / TIME / GENRE, widths from the
         shared, drag-resizable TrackColumns layout. -->
    <DataTemplate x:Key="TrackRowTemplate">
      <StackPanel Orientation="Horizontal" Background="Transparent">
        <StackPanel Orientation="Horizontal" Width="{Binding TitleWidth, Source={StaticResource TrackColumns}}"
                    Padding="6,0,6,0">
          <Border Width="40" Height="40" CornerRadius="4" Margin="0,0,10,0" Background="{StaticResource RaisedBrush}">
            <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
            <Border Background="Transparent" Margin="0,2,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding}" Tapped="SongArtistText_Tapped" ToolTipService.ToolTip="Go to artist">
              <TextBlock Text="{Binding ArtistName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </Border>
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding DurationDisplay}" VerticalAlignment="Center" Padding="6,0,6,0"
                   Width="{Binding TimeWidth, Source={StaticResource TrackColumns}}"/>
        <TextBlock Text="{Binding Genre}" VerticalAlignment="Center" Padding="6,0,6,0" TextTrimming="CharacterEllipsis"
                   Width="{Binding GenreWidth, Source={StaticResource TrackColumns}}"/>
      </StackPanel>
    </DataTemplate>

    <!-- Side queue panel row (Feishin's right sidebar): # (or a playing marker), art, title /
         artist, duration. Bound to a QueueEntry. -->
    <DataTemplate x:Key="SideQueueRowTemplate">
      <Grid Margin="0,4" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NumberVisibility}"/>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding CurrentMarkerVisibility}">
          <Rectangle Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}"/>
          <Rectangle Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="4" Margin="0,0,12,0" Background="{StaticResource RaisedBrush}">
          <Image Source="{Binding Song.CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Song.Title}" FontWeight="{Binding TitleFontWeight}" TextTrimming="CharacterEllipsis"/>
          <Border Background="Transparent" Margin="0,3,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding Song}" Tapped="SongArtistText_Tapped" ToolTipService.ToolTip="Go to artist">
            <TextBlock Text="{Binding Song.ArtistName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding Song.DurationDisplay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="12,0,6,0"/>
      </Grid>
    </DataTemplate>

    <!-- Queue row (full-screen player): 36px art + title / artist. Bound to a QueueEntry; the
         accent bar + bold title mark the playing track, independent of the multi-selection. -->
    <DataTemplate x:Key="QueueRowTemplate">
      <Grid Margin="2,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Width="3" Height="24" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                   Fill="{StaticResource AccentBrush}" Visibility="{Binding CurrentMarkerVisibility}"/>
        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="4" Margin="0,0,10,0" Background="{StaticResource RaisedBrush}">
          <Image Source="{Binding Song.CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Song.Title}" FontWeight="{Binding TitleFontWeight}" TextTrimming="CharacterEllipsis"/>
          <Border Background="Transparent" Margin="0,2,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tag="{Binding Song}" Tapped="SongArtistText_Tapped" ToolTipService.ToolTip="Go to artist">
            <TextBlock Text="{Binding Song.ArtistName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Page.Resources>


  <Grid>
    <!-- ================= Login ================= -->
    <Grid x:Name="LoginPanel">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Spacing="6">
        <TextBlock Text="LUNADROME" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,18"/>
        <TextBlock Text="SERVER URL" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,0"/>
        <TextBox x:Name="ServerUrlBox" Text="http://" Margin="0,0,0,8"/>
        <TextBlock Text="USERNAME" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,0"/>
        <TextBox x:Name="UsernameBox" Margin="0,0,0,8"/>
        <TextBlock Text="PASSWORD" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,0"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8"/>
        <CheckBox x:Name="RememberMeBox" Content="Remember me" IsChecked="True" FontSize="12"/>
        <Button x:Name="LoginButton" Content="Sign in" Click="LoginButton_Click" Height="36"
                HorizontalAlignment="Stretch" Margin="0,10,0,0" Style="{StaticResource PrimaryButtonStyle}"/>
        <TextBlock x:Name="StatusText" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="2,6,0,0"/>
      </StackPanel>
    </Grid>

    <!-- ================= Main shell ================= -->
    <Grid x:Name="LibraryPanel" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="20,20,20,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- ===== Sidebar ===== -->
          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <Grid Margin="8,0,0,16">
                <TextBlock Text="LUNADROME" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"/>
                <!-- Settings (#15): a gear drawn from strokes (no icon glyphs in this app). -->
                <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                        HorizontalAlignment="Right" Click="SettingsButton_Click"
                        AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                  <Grid Width="16" Height="16">
                    <Path Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8,0.8 L8,3 M8,13 L8,15.2 M0.8,8 L3,8 M13,8 L15.2,8 M2.9,2.9 L4.5,4.5 M11.5,11.5 L13.1,13.1 M2.9,13.1 L4.5,11.5 M11.5,4.5 L13.1,2.9"/>
                    <Ellipse Width="10.5" Height="10.5" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
                             Fill="{StaticResource BackgroundBrush}"/>
                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource TextSecondaryBrush}"/>
                  </Grid>
                </Button>
              </Grid>
              <!-- Library search (3.0); with SpotiDrome set up, also offers downloads. Enter searches. -->
              <Grid Margin="0,0,0,12">
                <TextBox x:Name="GlobalSearchBox" PlaceholderText="Search" Padding="10,6,34,6" KeyDown="GlobalSearchBox_KeyDown"
                         AutomationProperties.Name="Search"/>
                <!-- Magnifier: same as pressing Enter. -->
                <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                        Style="{StaticResource IconButtonStyle}" Click="GlobalSearchButton_Click"
                        AutomationProperties.Name="Run search" ToolTipService.ToolTip="Search">
                  <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M6,1 A5,5 0 1 1 5.99,1 M9.6,9.6 L13,13"/>
                </Button>
              </Grid>
              <RadioButton x:Name="NavHome" Content="Home" Tag="Home" GroupName="MainNav"
                           Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavArtists" Content="Artists" Tag="Artists" GroupName="MainNav"
                           Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavAlbums" Content="Albums" Tag="Albums" GroupName="MainNav"
                           Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavSongs" Content="Tracks" Tag="Songs" GroupName="MainNav"
                           Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
              <Grid Margin="8,24,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PLAYLISTS" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="+" Width="20" Height="20" FontSize="13" Padding="0,0,0,2"
                        Click="NewPlaylistButton_Click" ToolTipService.ToolTip="New playlist"/>
              </Grid>
            </StackPanel>
            <ListView Grid.Row="1" x:Name="PlaylistsList" SelectionMode="Single"
                      SelectionChanged="PlaylistsList_SelectionChanged" RightTapped="PlaylistsList_RightTapped">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="5" Margin="0,0,10,0" Background="{StaticResource RaisedBrush}">
                      <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2">
              <!-- SpotiDrome downloads: shown once something was sent this session. -->
              <Button x:Name="DownloadsButton" Visibility="Collapsed" HorizontalAlignment="Stretch" Height="34"
                      Margin="0,10,0,0" Click="DownloadsButton_Click" AutomationProperties.Name="Downloads"/>
              <!-- Shown only when GitHub has a newer release (UpdateChecker). -->
              <Button x:Name="UpdateButton" Visibility="Collapsed" HorizontalAlignment="Stretch" Height="34"
                      Margin="0,10,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="UpdateButton_Click"/>
            </StackPanel>
          </Grid>

          <!-- ===== Page host ===== -->
          <Grid Grid.Column="2">

            <!-- Search (3.0): the library first; with SpotiDrome configured, "Download via
                 SpotiDrome" below it (opened automatically when the library has nothing). -->
            <ScrollViewer x:Name="SearchPage" Visibility="Collapsed" controls:WheelScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,16,24" Spacing="6">
                <TextBlock x:Name="SearchHeaderText" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SearchLibraryStatusText" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>

                <StackPanel x:Name="SearchArtistsSection" Visibility="Collapsed">
                  <TextBlock Text="Artists" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/>
                  <muxc:ItemsRepeater x:Name="SearchArtistsList" ItemTemplate="{StaticResource SearchArtistTemplate}">
                    <muxc:ItemsRepeater.Layout>
                      <muxc:UniformGridLayout MinItemWidth="130" MinItemHeight="140" ItemsStretch="None" MinColumnSpacing="0" MinRowSpacing="0"/>
                    </muxc:ItemsRepeater.Layout>
                  </muxc:ItemsRepeater>
                </StackPanel>

                <StackPanel x:Name="SearchAlbumsSection" Visibility="Collapsed">
                  <TextBlock Text="Albums" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/>
                  <muxc:ItemsRepeater x:Name="SearchAlbumsList" ItemTemplate="{StaticResource LargeAlbumCardTemplate}">
                    <muxc:ItemsRepeater.Layout>
                      <muxc:UniformGridLayout MinItemWidth="162" MinItemHeight="200" ItemsStretch="None" MinColumnSpacing="0" MinRowSpacing="0"/>
                    </muxc:ItemsRepeater.Layout>
                  </muxc:ItemsRepeater>
                </StackPanel>

                <StackPanel x:Name="SearchSongsSection" Visibility="Collapsed">
                  <TextBlock Text="Songs" FontSize="20" FontWeight="Bold" Margin="0,12,0,6"/>
                  <controls:TrackListHeader Layout="{StaticResource TrackColumns}"/>
                  <!-- Same row template + handlers as the Tracks page (double-click plays, right-click menu). -->
                  <ListView x:Name="SearchSongsList" Tag="SearchSongs" SelectionMode="Single"
                            ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource SongItemStyle}"
                            DoubleTapped="TrackList_DoubleTapped" RightTapped="TrackList_RightTapped"/>
                </StackPanel>

                <!-- ===== Download via SpotiDrome ===== -->
                <Border x:Name="SpotiDromeSection" Visibility="Collapsed" Margin="0,20,0,0" Padding="20,16" CornerRadius="8"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <Button x:Name="SpotiDromeToggle" Click="SpotiDromeToggle_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Download via SpotiDrome">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Chevron: pointing right when collapsed, down when open. -->
                        <Path x:Name="SpotiDromeChevron" Width="10" Height="10" Stretch="Uniform" Margin="0,0,10,0"
                              Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M2,0 L7,5 L2,10" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform>
                            <RotateTransform x:Name="SpotiDromeChevronRotation" Angle="0"/>
                          </Path.RenderTransform>
                        </Path>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Download via SpotiDrome" FontSize="18" FontWeight="Bold"/>
                          <TextBlock x:Name="SpotiDromeSubtitle" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                     Text="Not what you're looking for? Search YouTube Music and download it into your library."/>
                        </StackPanel>
                      </Grid>
                    </Button>

                    <StackPanel x:Name="SpotiDromeContent" Visibility="Collapsed" Spacing="6" Margin="0,8,0,0">
                      <TextBlock x:Name="SpotiDromeStatusText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                      <!-- Results -->
                      <StackPanel x:Name="SpotiDromeResults" Spacing="6">
                        <StackPanel x:Name="YtSongsSection" Visibility="Collapsed">
                          <TextBlock Text="SONGS" Style="{StaticResource SectionHeaderStyle}" Margin="0,4,0,2"/>
                          <ItemsControl x:Name="YtSongsList" ItemTemplate="{StaticResource YtTrackTemplate}"/>
                        </StackPanel>
                        <StackPanel x:Name="YtAlbumsSection" Visibility="Collapsed">
                          <TextBlock Text="ALBUMS" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,2"/>
                          <muxc:ItemsRepeater x:Name="YtAlbumsList" ItemTemplate="{StaticResource YtAlbumCardTemplate}">
                            <muxc:ItemsRepeater.Layout>
                              <muxc:UniformGridLayout MinItemWidth="162" MinItemHeight="200" ItemsStretch="None" MinColumnSpacing="0" MinRowSpacing="0"/>
                            </muxc:ItemsRepeater.Layout>
                          </muxc:ItemsRepeater>
                        </StackPanel>
                        <StackPanel x:Name="YtVideosSection" Visibility="Collapsed">
                          <TextBlock Text="OTHER VERSIONS ON YOUTUBE" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,2"/>
                          <ItemsControl x:Name="YtVideosList" ItemTemplate="{StaticResource YtTrackTemplate}"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- One YouTube Music album: its tracks + Download album. -->
                      <StackPanel x:Name="YtAlbumDetail" Visibility="Collapsed" Spacing="10">
                        <Button Content="‹  Back to results" Click="YtAlbumBack_Click" Style="{StaticResource LinkButtonStyle}" Padding="0"/>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="140" Height="140" CornerRadius="9" Background="{StaticResource RaisedBrush}" Margin="0,0,20,0">
                            <Image x:Name="YtAlbumArt" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="YtAlbumTitle" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="YtAlbumMeta" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button x:Name="YtAlbumDownloadButton" Content="Download album" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="YtAlbumDownload_Click" Margin="0,10,0,0" Padding="18,8"/>
                          </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="YtAlbumTracksList" ItemTemplate="{StaticResource YtAlbumTrackTemplate}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Downloads sent to SpotiDrome this session, with live progress. -->
            <Grid x:Name="DownloadsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Downloads" FontSize="28" FontWeight="Bold" Margin="0,0,0,14"/>
              <ScrollViewer Grid.Row="1" controls:WheelScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DownloadsList" ItemTemplate="{StaticResource DownloadRowTemplate}" Margin="0,0,16,16"/>
              </ScrollViewer>
            </Grid>

            <!-- Settings (#15): appearance, playback, storage, account, about. Theme / accent
                 buttons are built in code (BuildSettingsChoices). -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" controls:WheelScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="14" Margin="0,0,16,24">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <StackPanel x:Name="ThemeOptions" Orientation="Horizontal" Spacing="8"/>
                    <TextBlock Text="Accent color" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <StackPanel x:Name="AccentOptions" Orientation="Horizontal" Spacing="8"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel Spacing="12">
                    <TextBlock Text="PLAYBACK" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <StackPanel>
                      <CheckBox x:Name="PrefetchCheck" Content="Pre-buffer the next song" Click="PreferenceCheck_Click"/>
                      <TextBlock Style="{StaticResource SettingsHintStyle}" Text="Downloads the next song in the queue while the current one plays, so it starts instantly."/>
                    </StackPanel>
                    <StackPanel>
                      <CheckBox x:Name="ResumeQueueCheck" Content="Resume the queue on startup" Click="PreferenceCheck_Click"/>
                      <TextBlock Style="{StaticResource SettingsHintStyle}" Text="Brings back the queue and position from last time, paused."/>
                    </StackPanel>
                    <StackPanel>
                      <CheckBox x:Name="OnlineLyricsCheck" Content="Find lyrics online (LRCLIB)" Click="PreferenceCheck_Click"/>
                      <TextBlock Style="{StaticResource SettingsHintStyle}" Text="When your server has no synced lyrics, looks the song up on lrclib.net (sends artist, title and album)."/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="SPOTIDROME" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0"
                               Text="Connect your SpotiDrome downloader to get &quot;Download via SpotiDrome&quot; in search: songs and albums from YouTube Music go straight into your library. Leave it empty to turn it off."/>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="SpotiDromeUrlBox" PlaceholderText="http://192.168.1.20:8080" AutomationProperties.Name="SpotiDrome address"/>
                      <Button Grid.Column="1" x:Name="SpotiDromeSaveButton" Style="{StaticResource TextButtonStyle}" Content="Save &amp; test" Click="SpotiDromeSave_Click"/>
                    </Grid>
                    <TextBlock x:Name="SpotiDromeTestText" Style="{StaticResource SettingsHintStyle}" Margin="0"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="STORAGE" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <Grid>
                      <TextBlock x:Name="CacheSizeText" VerticalAlignment="Center"/>
                      <Button Content="Clear" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right" Click="ClearCache_Click"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="ACCOUNT" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <Grid>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AccountUserText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AccountServerText" Style="{StaticResource SettingsHintStyle}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Button Content="Sign out" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SignOut_Click"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="ABOUT" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <Grid>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AboutVersionText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsHintStyle}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Button x:Name="CheckUpdatesButton" Style="{StaticResource TextButtonStyle}" Content="Check for updates" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Click="CheckUpdates_Click"/>
                    </Grid>
                    <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates when signing in" Click="PreferenceCheck_Click"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <Button Content="GitHub page" Style="{StaticResource TextButtonStyle}" Click="OpenGitHub_Click"/>
                      <Button Content="Report a problem" Style="{StaticResource TextButtonStyle}" Click="ReportProblem_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Home -->
            <ScrollViewer x:Name="HomePage" controls:WheelScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="HomeContent" Margin="0,0,16,8">

                <!-- Hero banner -->
                <Grid x:Name="HomeHeroCard" Height="232" Margin="0,0,16,28" Visibility="Collapsed">
                  <Border CornerRadius="14" Background="{StaticResource RaisedBrush}"/>
                  <Image x:Name="HeroBackdrop" Stretch="Fill" Margin="-50" IsHitTestVisible="False"/>
                  <Border CornerRadius="14" Background="#B3141517"/>

                  <Grid Margin="58,28">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="176" Height="176" VerticalAlignment="Center" Tapped="HeroPlayOverlay_Tapped">
                      <Border CornerRadius="10" Background="{StaticResource RaisedBrush}"/>
                      <Border x:Name="HeroArt" CornerRadius="10"/>
                      <Border CornerRadius="10" Background="#66000000" controls:Motion.HoverFade="True">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Polygon Points="0,0 16,10 0,20" Fill="{StaticResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Border>
                      </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                      <Border Background="Transparent" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tapped="HeroTitleText_Tapped" ToolTipService.ToolTip="Go to album">
                        <TextBlock x:Name="HeroTitleText" FontSize="30" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                      </Border>
                      <Border Background="Transparent" Margin="0,6,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tapped="HeroArtistText_Tapped" ToolTipService.ToolTip="Go to artist">
                        <TextBlock x:Name="HeroArtistText" FontSize="16" Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis"/>
                      </Border>
                      <TextBlock x:Name="HeroMetaText" FontSize="13" Margin="0,10,0,0" Foreground="#AAFFFFFF"/>
                    </StackPanel>
                  </Grid>

                  <Button Content="‹" Style="{StaticResource HeroNavButtonStyle}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                          Click="HeroPrevButton_Click"/>
                  <Button Content="›" Style="{StaticResource HeroNavButtonStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                          Click="HeroNextButton_Click"/>
                </Grid>

                <!-- Feishin Home rows: bold title-case headers with ‹ › arrows, big cards sized by
                     HomeLayout so a whole number of them fills the row width. Genres first, as in
                     Feishin. -->

                <!-- Genres: tile grid with a colored bar per genre -->
                <StackPanel x:Name="HomeGenresSection" Margin="0,0,0,32">
                  <TextBlock Text="Genres" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>
                  <muxc:ItemsRepeater x:Name="HomeGenresList">
                    <muxc:ItemsRepeater.Layout>
                      <muxc:UniformGridLayout MinColumnSpacing="16" MinRowSpacing="12" ItemsStretch="Fill"
                                              MinItemWidth="200" MinItemHeight="48"/>
                    </muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate>
                      <DataTemplate>
                        <Border Height="48" CornerRadius="4" Background="{StaticResource PanelBrush}"
                                Tag="{Binding}" Tapped="GenreCard_Tapped"
                                controls:Motion.HoverBackground="{StaticResource RaisedBrush}">
                          <Grid>
                            <Border Width="5" HorizontalAlignment="Left" CornerRadius="4,0,0,4"
                                    Background="{Binding Name, Converter={StaticResource GenreColor}}"/>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="22,0,12,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                  </muxc:ItemsRepeater>
                </StackPanel>

                <StackPanel x:Name="HomeMostPlayedSection" Margin="0,0,0,32">
                  <controls:CarouselHeader Title="Most Played"/>
                  <ScrollViewer Style="{StaticResource CarouselScrollViewerStyle}">
                    <ItemsControl x:Name="HomeMostPlayedList" ItemTemplate="{StaticResource HomeAlbumCardTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="HomeRecentlyPlayedSection" Margin="0,0,0,32">
                  <controls:CarouselHeader Title="Recently Played"/>
                  <ScrollViewer Style="{StaticResource CarouselScrollViewerStyle}">
                    <ItemsControl x:Name="HomeRecentlyPlayedList" ItemTemplate="{StaticResource HomeAlbumCardTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="HomeRecentlyAddedSection" Margin="0,0,0,32">
                  <controls:CarouselHeader Title="Recently Added" ShowMore="True" MoreClick="HomeMoreAlbumsButton_Click"/>
                  <ScrollViewer Style="{StaticResource CarouselScrollViewerStyle}">
                    <ItemsControl x:Name="HomeAlbumsList" ItemTemplate="{StaticResource HomeAlbumCardTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="HomeExploreSection" Margin="0,0,0,32">
                  <controls:CarouselHeader Title="Explore from your library"/>
                  <ScrollViewer Style="{StaticResource CarouselScrollViewerStyle}">
                    <ItemsControl x:Name="HomeExploreList" ItemTemplate="{StaticResource HomeAlbumCardTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="HomePlaylistsSection" Margin="0,0,0,16">
                  <controls:CarouselHeader Title="Playlists"/>
                  <ScrollViewer Style="{StaticResource CarouselScrollViewerStyle}">
                    <ItemsControl x:Name="HomePlaylistsList">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Width="{Binding CardWidth, Source={StaticResource HomeLayout}}" Background="Transparent"
                                      Tag="{Binding}" Tapped="HomePlaylistCard_Tapped">
                            <Border CornerRadius="6" Background="{StaticResource RaisedBrush}"
                                    Width="{Binding CardWidth, Source={StaticResource HomeLayout}}"
                                    Height="{Binding CardWidth, Source={StaticResource HomeLayout}}">
                              <Image Source="{Binding CoverArtUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SongCount, Converter={StaticResource Format}, ConverterParameter='{}{0} tracks'}"
                                       FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>

              </StackPanel>
            </ScrollViewer>

            <!-- Artists -->
            <Grid x:Name="ArtistsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ARTISTS" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,10,0"/>
                <TextBox x:Name="ArtistSearchBox" Grid.Column="2" PlaceholderText="Search" TextChanged="ArtistSearchBox_TextChanged"/>
              </Grid>
              <ListView Grid.Row="1" x:Name="ArtistsList" DisplayMemberPath="Name" SelectionMode="Single"
                        SelectionChanged="ArtistsList_SelectionChanged"/>
            </Grid>

            <!-- Artist detail (Feishin's artist page): blurred-art header with the cover, an
                 "ARTIST" eyebrow, big name, album/track counts, Play / Next / Last + favorite,
                 then the "Album" grid. -->
            <ScrollViewer x:Name="ArtistDetailPage" controls:WheelScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,16,16">
                <Grid Height="290" Margin="0,0,0,28">
                  <Border CornerRadius="14" Background="{StaticResource RaisedBrush}"/>
                  <Border CornerRadius="14">
                    <Image x:Name="ArtistHeaderBackdrop" Stretch="UniformToFill" IsHitTestVisible="False"/>
                  </Border>
                  <Border CornerRadius="14">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#40000000" Offset="0"/>
                        <GradientStop Color="#E01A1B1E" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>

                  <Grid Margin="32,0,28,32" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="200" Height="200">
                      <Border CornerRadius="6" Background="{StaticResource RaisedBrush}"/>
                      <Border x:Name="ArtistHeaderArt" CornerRadius="6"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                      <TextBlock Text="ARTIST" FontSize="13" FontWeight="Bold" Foreground="White"/>
                      <TextBlock x:Name="ArtistHeaderNameText" FontSize="44" FontWeight="Bold" Foreground="White"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      <TextBlock x:Name="ArtistHeaderStatsText" FontSize="14" FontWeight="SemiBold" Foreground="#DDFFFFFF" Margin="0,4,0,0"/>
                      <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Spacing="12">
                        <Button Style="{StaticResource PillButtonStyle}" Click="ArtistHeaderPlayButton_Click">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Polygon Points="0,0 10,6.5 0,13" Fill="{StaticResource OnAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Play" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}"/>
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButtonStyle}" Click="ArtistHeaderNextButton_Click"
                                ToolTipService.ToolTip="Play next">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="14" Height="12" Stretch="Uniform" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Data="M2,13 L2,9 C2,6 4,4.5 7,4.5 L14,4.5 M10.5,1 L14,4.5 L10.5,8"/>
                            <TextBlock Text="Next" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}"/>
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButtonStyle}" Click="ArtistHeaderLastButton_Click"
                                ToolTipService.ToolTip="Add to queue">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="13" Height="11" Stretch="Uniform" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Data="M1,6 L9,6 M5.5,2.5 L9,6 L5.5,9.5 M13,1 L13,11"/>
                            <TextBlock Text="Last" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,2"
                            Click="ArtistFavoriteButton_Click" ToolTipService.ToolTip="Favorite">
                      <Path x:Name="ArtistFavoriteIcon" Width="18" Height="17" Stretch="Uniform"
                            Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                            Data="M8,15 C8,15 1,10.5 1,5.8 C1,3 3,1.3 5.4,1.3 C6.9,1.3 7.7,2.1 8,2.6 C8.3,2.1 9.1,1.3 10.6,1.3 C13,1.3 15,3 15,5.8 C15,10.5 8,15 8,15 Z"/>
                    </Button>
                  </Grid>
                </Grid>

                <!-- "Album  [8] ─────────" section header -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Album" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Margin="10,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                          BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1">
                    <TextBlock x:Name="ArtistAlbumCountText" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                  <Rectangle Grid.Column="2" Height="1" Margin="14,0,0,0" Fill="{StaticResource BorderBrush2}" VerticalAlignment="Center"/>
                </Grid>
                <muxc:ItemsRepeater x:Name="ArtistAlbumsList" ItemTemplate="{StaticResource FeishinAlbumCardTemplate}">
                  <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="184" MinItemHeight="252" ItemsStretch="None"
                                            MinColumnSpacing="0" MinRowSpacing="0"/>
                  </muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
              </StackPanel>
            </ScrollViewer>

            <!-- Album page (Feishin): header tinted with the cover's average color, cover,
                 "ALBUM" eyebrow, big title, meta line, artist link, Play / Next / Last, then a
                 searchable # / TITLE / time / favorite track table. -->
            <ScrollViewer x:Name="AlbumPage" controls:WheelScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,16,16">
                <Grid Height="290" Margin="0,0,0,24">
                  <Border x:Name="AlbumHeaderTint" CornerRadius="14" Background="{StaticResource RaisedBrush}"/>
                  <Border CornerRadius="14">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#661A1B1E" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>

                  <Grid Margin="32,0,28,32" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="200" Height="200">
                      <Border CornerRadius="6" Background="{StaticResource RaisedBrush}"/>
                      <Border x:Name="AlbumHeaderArt" CornerRadius="6"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                      <TextBlock Text="ALBUM" FontSize="13" FontWeight="Bold" Foreground="White"/>
                      <TextBlock x:Name="AlbumHeaderTitleText" FontSize="44" FontWeight="Bold" Foreground="White"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      <TextBlock x:Name="AlbumHeaderMetaText" FontSize="14" FontWeight="SemiBold" Foreground="#DDFFFFFF" Margin="0,4,0,0"/>
                      <Border Background="Transparent" Margin="0,6,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tapped="AlbumHeaderArtistText_Tapped">
                        <TextBlock x:Name="AlbumHeaderArtistText" FontSize="14" FontWeight="SemiBold" Foreground="#DDFFFFFF"/>
                      </Border>
                      <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Spacing="12">
                        <Button Style="{StaticResource PillButtonStyle}" Click="AlbumPlayButton_Click">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Polygon Points="0,0 10,6.5 0,13" Fill="{StaticResource OnAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Play" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}"/>
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButtonStyle}" Click="AlbumNextButton_Click"
                                ToolTipService.ToolTip="Play next">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="14" Height="12" Stretch="Uniform" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Data="M2,13 L2,9 C2,6 4,4.5 7,4.5 L14,4.5 M10.5,1 L14,4.5 L10.5,8"/>
                            <TextBlock Text="Next" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}"/>
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButtonStyle}" Click="AlbumLastButton_Click"
                                ToolTipService.ToolTip="Add to queue">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="13" Height="11" Stretch="Uniform" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Data="M1,6 L9,6 M5.5,2.5 L9,6 L5.5,9.5 M13,1 L13,11"/>
                            <TextBlock Text="Last" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Grid>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="AlbumTrackSearchBox" Grid.Column="0" PlaceholderText="Search" MinHeight="34"
                           CornerRadius="18" Padding="16,8" TextChanged="AlbumTrackSearchBox_TextChanged"/>
                  <StackPanel x:Name="AlbumGenrePanel" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GENRE" FontSize="13" FontWeight="Bold"/>
                    <Border Margin="0,4,0,0" Padding="10,3" CornerRadius="4" HorizontalAlignment="Left"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                      <TextBlock x:Name="AlbumGenreText" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>
                </Grid>

                <!-- Table header: note icon / TITLE / clock icon / heart -->
                <Grid Height="36" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="60"/>
                  </Grid.ColumnDefinitions>
                  <Path Grid.Column="0" Width="11" Height="13" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M5,12 A2,2 0 1 1 5,11.99 M7,12 L7,2 L13,1 L13,10 M13,10 A2,2 0 1 1 13,9.99"/>
                  <TextBlock Grid.Column="1" Text="TITLE" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Grid Grid.Column="2" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4"/>
                    <Path Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" StrokeEndLineCap="Round"
                          Data="M6.5,3.5 L6.5,6.8 L8.8,8.2"/>
                  </Grid>
                  <Path Grid.Column="3" Width="14" Height="13" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M8,15 C8,15 1,10.5 1,5.8 C1,3 3,1.3 5.4,1.3 C6.9,1.3 7.7,2.1 8,2.6 C8.3,2.1 9.1,1.3 10.6,1.3 C13,1.3 15,3 15,5.8 C15,10.5 8,15 8,15 Z"/>
                </Grid>
                <muxc:ItemsRepeater x:Name="AlbumSongsList" ItemTemplate="{StaticResource AlbumTrackRowTemplate}"/>
              </StackPanel>
            </ScrollViewer>

            <!-- Albums -->
            <Grid x:Name="AlbumsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ALL ALBUMS" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,10,0"/>
                <TextBox x:Name="AllAlbumsSearchBox" Grid.Column="2" PlaceholderText="Search" TextChanged="AllAlbumsSearchBox_TextChanged"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" controls:WheelScroll.Enabled="True">
                <muxc:ItemsRepeater x:Name="AllAlbumsList" ItemTemplate="{StaticResource LargeAlbumCardTemplate}">
                  <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="162" MinItemHeight="200" ItemsStretch="None"
                                            MinColumnSpacing="0" MinRowSpacing="0"/>
                  </muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
              </ScrollViewer>
            </Grid>

            <!-- Tracks (whole library) -->
            <Grid x:Name="SongsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <Button Width="30" Height="30" Margin="0,0,10,0" Tag="AllTracks"
                          Style="{StaticResource PrimaryButtonStyle}" Click="PlayMenuButton_Click" AutomationProperties.Name="Play menu" ToolTipService.ToolTip="Play">
                    <Polygon Points="0,0 9,5.5 0,11" Fill="{StaticResource OnAccentBrush}" Margin="2,0,0,0"/>
                  </Button>
                  <TextBlock Text="ALL TRACKS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="AllTracksSearchBox" Grid.Column="2" PlaceholderText="Search" Tag="AllTracks"
                         TextChanged="TrackSearchBox_TextChanged"/>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="AllTracksSortButton" Content="Sort ▾" Tag="AllTracks" Padding="14,6" Click="SortButton_Click"/>
                <Button x:Name="AllTracksSortDirectionButton" Content="↑" Tag="AllTracks" Width="34" Height="34"
                        Margin="8,0,0,0" FontSize="13" Click="SortDirectionButton_Click"
                        ToolTipService.ToolTip="Toggle ascending/descending"/>
              </StackPanel>
              <controls:TrackListHeader Grid.Row="2" Layout="{StaticResource TrackColumns}"/>
              <ListView Grid.Row="3" x:Name="AllSongsList" Tag="AllTracks" SelectionMode="Single"
                        ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource SongItemStyle}"
                        DoubleTapped="TrackList_DoubleTapped" RightTapped="TrackList_RightTapped"/>
            </Grid>

            <!-- Genre detail -->
            <Grid x:Name="GenreAlbumsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="GenreAlbumsHeader" Grid.Row="0" Text="GENRE" Style="{StaticResource SectionHeaderStyle}"
                         Margin="0,0,0,10"/>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" controls:WheelScroll.Enabled="True">
                <muxc:ItemsRepeater x:Name="GenreAlbumsList" ItemTemplate="{StaticResource LargeAlbumCardTemplate}">
                  <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="162" MinItemHeight="200" ItemsStretch="None"
                                            MinColumnSpacing="0" MinRowSpacing="0"/>
                  </muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
              </ScrollViewer>
            </Grid>

            <!-- Playlist detail -->
            <Grid x:Name="PlaylistsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <Grid Width="44" Height="44" Margin="2,0,10,0">
                    <Border CornerRadius="6" Background="{StaticResource RaisedBrush}"/>
                    <Border x:Name="PlaylistHeaderArt" CornerRadius="6"/>
                  </Grid>
                  <TextBlock x:Name="PlaylistTracksHeader" Text="PLAYLIST" Style="{StaticResource SectionHeaderStyle}"
                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <Button Width="30" Height="30" VerticalAlignment="Center" Tag="PlaylistTracks"
                          Style="{StaticResource PrimaryButtonStyle}" Click="PlayMenuButton_Click" AutomationProperties.Name="Play menu" ToolTipService.ToolTip="Play">
                    <Polygon Points="0,0 9,5.5 0,11" Fill="{StaticResource OnAccentBrush}" Margin="2,0,0,0"/>
                  </Button>
                </StackPanel>
                <TextBox x:Name="PlaylistTrackSearchBox" Grid.Column="2" PlaceholderText="Search" Tag="PlaylistTracks"
                         TextChanged="TrackSearchBox_TextChanged"/>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="PlaylistTrackSortButton" Content="Sort ▾" Tag="PlaylistTracks" Padding="14,6" Click="SortButton_Click"/>
                <Button x:Name="PlaylistTrackSortDirectionButton" Content="↑" Tag="PlaylistTracks" Width="34" Height="34"
                        Margin="8,0,0,0" FontSize="13" Click="SortDirectionButton_Click"
                        ToolTipService.ToolTip="Toggle ascending/descending"/>
              </StackPanel>
              <controls:TrackListHeader Grid.Row="2" Layout="{StaticResource TrackColumns}"/>
              <ListView Grid.Row="3" x:Name="PlaylistSongsList" Tag="PlaylistTracks" SelectionMode="Single"
                        ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource SongItemStyle}"
                        DoubleTapped="TrackList_DoubleTapped" RightTapped="TrackList_RightTapped"/>
            </Grid>

            <!-- Short notice over the pages (a download finished, ...), with an optional action. -->
            <Border x:Name="ToastBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                    Padding="18,10" CornerRadius="8" Background="{StaticResource RaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" MaxWidth="560">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                <Button x:Name="ToastActionButton" Visibility="Collapsed" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" MinHeight="30"
                        VerticalAlignment="Center" Click="ToastAction_Click"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ===== Queue side panel (the Queue button; Feishin's right sidebar) =====
               Docked next to the pages, which shrink to make room. Toolbar acts on the selected
               rows; synced lyrics for the playing track underneath. -->
          <Border Grid.Column="3" x:Name="QueueSidePanel" Visibility="Collapsed" Width="420" Margin="16,0,0,0"
                  Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,4" Spacing="2">
                <Button Style="{StaticResource IconButtonStyle}" Click="SideQueueShuffle_Click"
                        AutomationProperties.Name="Shuffle queue" ToolTipService.ToolTip="Shuffle the upcoming songs">
                  <Path Width="16" Height="14" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M1,4 L6,4 L15,13 M11,13 L15,13 L15,9 M1,12 L6,12 L15,3 M11,3 L15,3 L15,7"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="SideQueuePlayNext_Click"
                        AutomationProperties.Name="Play selected next" ToolTipService.ToolTip="Play selected next">
                  <Path Width="16" Height="14" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M2,2 L2,9 L14,9 M10,5 L14,9 L10,13"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="SideQueueMoveToEnd_Click"
                        AutomationProperties.Name="Move selected to end" ToolTipService.ToolTip="Move selected to the end">
                  <Path Width="16" Height="14" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M1,2 L9,2 M1,7 L9,7 M1,12 L6,12 M13,3 L13,13 M10,10 L13,13 L16,10"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="SideQueueRemove_Click"
                        AutomationProperties.Name="Remove selected" ToolTipService.ToolTip="Remove selected from the queue">
                  <Path Width="14" Height="15" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M1,4 L13,4 M5,4 L5,1.5 L9,1.5 L9,4 M2.5,4 L3.5,14 L10.5,14 L11.5,4"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="SideQueueClear_Click"
                        AutomationProperties.Name="Clear queue" ToolTipService.ToolTip="Clear the queue (keeps the playing song)">
                  <Path Width="16" Height="14" Stretch="Uniform" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M1,2 L11,2 M1,7 L8,7 M1,12 L6,12 M10,8 L15,13 M15,8 L10,13"/>
                </Button>
              </StackPanel>

              <Grid Grid.Row="1" Margin="10,4,16,4" Padding="0,0,0,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource SectionHeaderStyle}" Margin="0" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="TITLE" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                <!-- Clock icon over the duration column. -->
                <Grid Grid.Column="2" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Ellipse Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"/>
                  <Path Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M7,3.5 L7,7 L9.5,8.5"/>
                </Grid>
              </Grid>

              <!-- Same queue as the full-screen player's Queue tab, its own list (selection etc.). -->
              <ListView Grid.Row="2" x:Name="SideQueueList" SelectionMode="Extended" Padding="6,0,6,6"
                        ItemTemplate="{StaticResource SideQueueRowTemplate}"
                        CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                        DoubleTapped="QueueList_DoubleTapped" RightTapped="QueueList_RightTapped" KeyDown="QueueList_KeyDown"/>

              <!-- Synced lyrics: previous / current / next line; unsynced ones scroll as plain text. -->
              <Grid Grid.Row="3" x:Name="SideLyricsPanel" Height="170" Visibility="Collapsed"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="SideLyricsSynced" VerticalAlignment="Center" Spacing="12" Padding="20,0">
                  <TextBlock x:Name="SideLyricPrev" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6"
                             TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
                  <TextBlock x:Name="SideLyricCurrent" FontSize="19" FontWeight="Bold"
                             TextAlignment="Center" TextWrapping="Wrap" MaxLines="3"/>
                  <TextBlock x:Name="SideLyricNext" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6"
                             TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
                </StackPanel>
                <ScrollViewer x:Name="SideLyricsPlain" Visibility="Collapsed" controls:WheelScroll.Enabled="True" Padding="20,12">
                  <TextBlock x:Name="SideLyricsPlainText" FontSize="14" LineHeight="22" TextAlignment="Center" TextWrapping="Wrap"/>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== Full-screen player (click the now-playing title) ===== -->
        <Grid x:Name="FullScreenPlayerOverlay" Background="{StaticResource BackgroundBrush}" Visibility="Collapsed">
          <Grid Margin="80,40,80,60">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid Width="360" Height="360">
                <Border CornerRadius="12" Background="{StaticResource RaisedBrush}"/>
                <Border x:Name="FullScreenArt" CornerRadius="12"/>
              </Grid>
              <TextBlock x:Name="FullScreenTitleText" FontSize="24" FontWeight="Bold" Margin="0,28,0,0"
                         HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
              <Border Background="Transparent" Margin="0,8,0,0" HorizontalAlignment="Center" controls:Motion.ClickableText="True" Tapped="NowPlayingArtist_Tapped" ToolTipService.ToolTip="Go to artist">
                <TextBlock x:Name="FullScreenArtistText" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
              </Border>
            </StackPanel>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="QueueTabButton" Grid.Column="0" Content="Queue" Tag="Queue" GroupName="SidePanelTabs"
                             Style="{StaticResource SidePanelTabStyle}" Checked="SidePanelTabButton_Checked"/>
                <RadioButton x:Name="LyricsTabButton" Grid.Column="1" Content="Lyrics" Tag="Lyrics" GroupName="SidePanelTabs"
                             Style="{StaticResource SidePanelTabStyle}" Checked="SidePanelTabButton_Checked"/>
                <RadioButton x:Name="VisualizerTabButton" Grid.Column="2" Content="Visualizer" Tag="Visualizer" GroupName="SidePanelTabs"
                             Style="{StaticResource SidePanelTabStyle}" Checked="SidePanelTabButton_Checked"/>
              </Grid>
              <Grid Grid.Row="1">
                <!-- Ctrl/Shift-click to select several rows, then right-click to move or remove them
                     together; rows can also be dragged to reorder, and Delete removes the selection. -->
                <ListView x:Name="QueueList" SelectionMode="Extended" ItemTemplate="{StaticResource QueueRowTemplate}"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                          DoubleTapped="QueueList_DoubleTapped" RightTapped="QueueList_RightTapped" KeyDown="QueueList_KeyDown"/>

                <Grid x:Name="LyricsPanelView" Visibility="Collapsed">
                  <TextBlock x:Name="LyricsPlaceholder" Text="No lyrics found for this track." TextWrapping="Wrap"
                             Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
                  <ListView x:Name="LyricsList" SelectionMode="Single" DoubleTapped="LyricsList_DoubleTapped">
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4"/>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Grid>

                <Grid x:Name="VisualizerPanelView" Visibility="Collapsed">
                  <!-- Drawn directly with SkiaSharp (see VisualizerCanvas) - a XAML Path rebuilt every frame was too slow on Uno. -->
                  <controls:VisualizerCanvas x:Name="VisualizerCanvas"/>
                </Grid>
              </Grid>
            </Grid>
          </Grid>

          <Button Content="✕" Width="34" Height="34" FontSize="13" Margin="24"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Click="CloseFullScreenPlayer_Click" ToolTipService.ToolTip="Close"/>
        </Grid>
      </Grid>

      <!-- ================= Playback bar ================= -->
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
              BorderThickness="0,1,0,0" Padding="24,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
          </Grid.ColumnDefinitions>

          <!-- Now playing -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="56" Height="56">
              <Border CornerRadius="6" Background="{StaticResource RaisedBrush}"/>
              <Border x:Name="NowPlayingArt" CornerRadius="6"/>
            </Grid>
            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="220">
              <Border Background="Transparent" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tapped="NowPlayingText_Tapped" ToolTipService.ToolTip="Show/hide Queue, Lyrics, Visualizer">
                <TextBlock x:Name="NowPlayingText" FontWeight="SemiBold" Text="Nothing playing" FontSize="12" TextTrimming="CharacterEllipsis"/>
              </Border>
              <Border Background="Transparent" Margin="0,2,0,0" HorizontalAlignment="Left" controls:Motion.ClickableText="True" Tapped="NowPlayingArtist_Tapped" ToolTipService.ToolTip="Go to artist">
                <TextBlock x:Name="NowPlayingSubText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Transport + progress -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="StopButton" Style="{StaticResource IconButtonStyle}" Click="StopButton_Click" AutomationProperties.Name="Stop"
                      ToolTipService.ToolTip="Stop">
                <Rectangle Width="12" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource TextPrimaryBrush}"/>
              </Button>

              <Button x:Name="ShuffleButton" Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                      Click="ShuffleButton_Click" AutomationProperties.Name="Shuffle" ToolTipService.ToolTip="Shuffle">
                <Path x:Name="ShuffleIconPath" Width="16" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M1,4 L6,4 L15,13 M11,13 L15,13 L15,9 M1,12 L6,12 L15,3 M11,3 L15,3 L15,7"/>
              </Button>

              <Button x:Name="PreviousButton" Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                      Click="PreviousButton_Click" AutomationProperties.Name="Previous" ToolTipService.ToolTip="Previous">
                <Canvas Width="14" Height="14">
                  <Rectangle Width="2" Height="14" Fill="{StaticResource TextPrimaryBrush}"/>
                  <Polygon Points="12,1 4,7 12,13" Fill="{StaticResource TextPrimaryBrush}"/>
                </Canvas>
              </Button>

              <Button x:Name="PlayPauseButton" Width="44" Height="44" CornerRadius="22" Margin="8,0"
                      Style="{StaticResource PrimaryButtonStyle}" Click="PlayPauseButton_Click" AutomationProperties.Name="Play/Pause" ToolTipService.ToolTip="Play/Pause">
                <Grid Width="16" Height="16">
                  <Polygon x:Name="PlayIcon" Points="1,0 15,8 1,16" Fill="{StaticResource OnAccentBrush}"/>
                  <Grid x:Name="PauseIcon" Visibility="Collapsed">
                    <Rectangle Width="4" Height="16" HorizontalAlignment="Left" Fill="{StaticResource OnAccentBrush}"/>
                    <Rectangle Width="4" Height="16" HorizontalAlignment="Right" Fill="{StaticResource OnAccentBrush}"/>
                  </Grid>
                </Grid>
              </Button>

              <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}" Click="NextButton_Click" AutomationProperties.Name="Next"
                      ToolTipService.ToolTip="Next">
                <Canvas Width="14" Height="14">
                  <Polygon Points="2,1 10,7 2,13" Fill="{StaticResource TextPrimaryBrush}"/>
                  <Rectangle Canvas.Left="12" Width="2" Height="14" Fill="{StaticResource TextPrimaryBrush}"/>
                </Canvas>
              </Button>

              <Button x:Name="RepeatButton" Style="{StaticResource IconButtonStyle}" Margin="0,0,2,0"
                      Click="RepeatButton_Click" AutomationProperties.Name="Repeat" ToolTipService.ToolTip="Repeat">
                <Grid Width="16" Height="16">
                  <Path x:Name="RepeatIconPath" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 12,3 A 6,6 0 1 1 4,3"/>
                  <Polygon x:Name="RepeatArrowHead" Points="12,0.5 16,3 12,5.5" Fill="{StaticResource TextSecondaryBrush}"/>
                  <TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="8" FontWeight="Bold"
                             Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                </Grid>
              </Button>

              <Button x:Name="QueueToggleButton" Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                      Click="QueueToggleButton_Click" AutomationProperties.Name="Queue" ToolTipService.ToolTip="Queue">
                <StackPanel VerticalAlignment="Center">
                  <Rectangle Width="16" Height="2" Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                  <Rectangle Width="16" Height="2" Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                  <Rectangle Width="10" Height="2" Fill="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ElapsedText" Grid.Column="0" Text="0:00" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="1" Value="0"/>
              <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>

          <!-- Volume -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="VOL" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.8"
                    ValueChanged="VolumeSlider_ValueChanged"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
