<Page x:Class="LunaDrome.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LunaDrome"
      xmlns:us="using:Uno.Simple"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <!-- Login: server URL / username / password, calls NavidromeClient from LunaDrome.Core -->
    <StackPanel x:Name="LoginPanel"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="320" Spacing="10">
      <TextBlock Text="LunaDrome" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

      <TextBlock Text="Server URL"/>
      <TextBox x:Name="ServerUrlBox" Text="http://"/>

      <TextBlock Text="Username"/>
      <TextBox x:Name="UsernameBox"/>

      <TextBlock Text="Password"/>
      <PasswordBox x:Name="PasswordBox"/>

      <Button x:Name="LoginButton" Content="Sign in" Click="LoginButton_Click"
              HorizontalAlignment="Stretch" Margin="0,10,0,0"/>

      <TextBlock x:Name="StatusText" Foreground="OrangeRed" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Shown after a successful login: Artists + Tracks (library-wide), and a playback bar -->
    <Grid x:Name="LibraryPanel" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Artists" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
          <ListView Grid.Row="1" x:Name="ArtistsList">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="{Binding Name}" FontSize="14"/>
                  <TextBlock Text="{Binding AlbumCount}" FontSize="12" Opacity="0.6" Margin="8,0,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Tracks (double-click to play)" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
          <ListView Grid.Row="1" x:Name="TracksList" DoubleTapped="TracksList_DoubleTapped">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <TextBlock Text="{Binding Title}" FontSize="14" Width="260"/>
                  <TextBlock Text="{Binding ArtistName}" FontSize="12" Opacity="0.6" Width="180"/>
                  <TextBlock Text="{Binding DurationDisplay}" FontSize="12" Opacity="0.6"/>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Grid>

      <!-- Playback bar -->
      <Grid Grid.Row="1" Padding="16,10" Background="#1A1A1A">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="NowPlayingText" Grid.Column="0" Text="Nothing playing"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPauseButton_Click" Width="70"/>
          <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" Width="70"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
          <TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center" Width="40"/>
          <Slider x:Name="ProgressSlider" Width="260" Minimum="0" Maximum="1"
                  PointerCaptureLost="ProgressSlider_PointerCaptureLost"/>
          <TextBlock x:Name="DurationText" Text="0:00" VerticalAlignment="Center" Width="40"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Vol" VerticalAlignment="Center"/>
          <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="80"
                  ValueChanged="VolumeSlider_ValueChanged"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
