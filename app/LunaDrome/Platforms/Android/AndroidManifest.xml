<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Finding Sendspin speakers (mDNS): Android drops multicast unless a MulticastLock is held. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- Built-in updates: the downloaded APK is handed to the system installer (AndroidUpdateInstaller). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Navidrome / SpotiDrome / JamiDrome often run on a LAN over plain http. -->
  <!-- Android 11+ only lets us see Android Auto's connection state (CarConnection.cs) when we say so. -->
  <queries>
    <package android:name="com.google.android.projection.gearhead" />
    <provider android:authorities="androidx.car.app.connection" />
  </queries>
  <application android:allowBackup="true" android:supportsRtl="true" android:usesCleartextTraffic="true">
    <!-- Android Auto (#26): LunaMediaService is the media browser it connects to. -->
    <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
    <!-- Headset / notification buttons, forwarded to LunaMediaService's session. -->
    <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
