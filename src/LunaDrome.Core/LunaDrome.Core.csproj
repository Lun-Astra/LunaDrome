<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- mDNS discovery of Sendspin speakers (_sendspin._tcp). -->
    <PackageReference Include="Zeroconf" Version="3.7.16" />
    <!-- Sendspin encryption (Noise: X25519, ChaCha20-Poly1305, AES-GCM) and pairing (CPace):
         managed, so the same code runs on Windows, Linux, Android and iOS. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- MP3 decoding (pure C#) for Sendspin streaming on phones. -->
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>

</Project>
