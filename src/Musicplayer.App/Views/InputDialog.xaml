<Window x:Class="Musicplayer.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaDrome" Width="360" SizeToContent="Height"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="PromptText" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" Margin="0,0,0,20" KeyDown="InputBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,8" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="OK" Padding="16,8" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OkButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
