<Window x:Class="Musicplayer.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaDrome — Sign in to Navidrome"
        Icon="/icon.ico"
        Width="420" SizeToContent="Height"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <Grid>
        <Border MaxWidth="340" Background="{StaticResource PanelBrush}"
                CornerRadius="12" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="LUNADROME" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to Navidrome" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,22"/>

                <TextBlock Text="Server URL" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                <TextBox x:Name="ServerUrlBox" Text="http://" Margin="0,0,0,14"/>

                <TextBlock Text="Username" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,14"/>

                <TextBlock Text="Password" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14"/>

                <CheckBox x:Name="RememberMeBox" Content="Remember server &amp; username" IsChecked="True" Margin="0,0,0,16"/>

                <TextBlock x:Name="StatusText" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Button x:Name="LoginButton" Content="Sign in" Height="38" Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
