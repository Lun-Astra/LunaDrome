<Window x:Class="Musicplayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaDrome" Height="720" Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="LocalTrackListViewItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource SongListViewItemStyle}">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TrackItem_PreviewMouseRightButtonDown"/>
        </Style>

        <Style x:Key="PlaylistListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="PlaylistItem_PreviewMouseRightButtonDown"/>
        </Style>

        <!-- Track title column: cover art + title (with artist below it) as one resizable unit -->
        <DataTemplate x:Key="TrackTitleCellTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                <Grid Width="40" Height="40" Margin="0,0,10,0">
                    <Border CornerRadius="4" Background="{StaticResource RaisedBrush}"/>
                    <Border CornerRadius="4">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CoverArtUrl}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ArtistName}" FontSize="11" Cursor="Hand"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Style="{StaticResource ClickableTextStyle}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               MouseLeftButtonDown="SongArtistText_MouseLeftButtonDown"
                               ToolTip="Go to artist"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Hover-overlay trigger lives directly on the overlay Border's own IsMouseOver, not an
             ancestor lookup (RelativeSource AncestorType=X). An ancestor lookup only works for
             whichever single container type (ListBoxItem, ContentPresenter, ...) the template
             happened to be tuned for - it silently breaks (every card in the same container lights
             up together) the moment the template gets reused somewhere with a different container
             type, which is exactly what happened when these cards were reused in Home's plain
             ItemsControl rows. A trigger on the Border's own bounds has no such dependency.
             Animated (not an instant Setter) so the play button eases in/out on hover. -->
        <Style x:Key="AlbumHoverOverlayStyle" TargetType="Border">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Whole-card hover: a gentle scale-up, independent of the overlay fade above (this
             targets the card's own root panel, not the image Border, so it reacts a hair sooner/
             over the card's full footprint including the title/artist text below the art). -->
        <Style x:Key="AlbumCardScaleStyle" TargetType="StackPanel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.035" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.035" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared album card look, used by Home / Artists / Albums pages -->
        <DataTemplate x:Key="AlbumCardTemplate">
            <StackPanel Width="112" Margin="2,4" Style="{StaticResource AlbumCardScaleStyle}">
                <Grid Width="104" Height="104">
                    <Border CornerRadius="8" Background="{StaticResource RaisedBrush}"/>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CoverArtUrl}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border x:Name="HoverOverlay" CornerRadius="8" Background="#99000000" Opacity="0"
                            Style="{StaticResource AlbumHoverOverlayStyle}"
                            MouseLeftButtonDown="AlbumPlayOverlay_MouseLeftButtonDown">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="▶" FontSize="13" Foreground="{StaticResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Border>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,6,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="104"/>
                <TextBlock x:Name="CardArtistText" Text="{Binding ArtistName}" FontSize="11" Margin="2,1,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"
                           Style="{StaticResource ClickableTextStyle}"
                           TextTrimming="CharacterEllipsis" MaxWidth="104"
                           MouseLeftButtonDown="CardArtistText_MouseLeftButtonDown" ToolTip="Go to artist"/>
            </StackPanel>
        </DataTemplate>

        <!-- Larger album card, used by the library-wide Albums grid, Genre pages, and Home's feature row -->
        <DataTemplate x:Key="LargeAlbumCardTemplate">
            <StackPanel Width="152" Margin="5,8" Style="{StaticResource AlbumCardScaleStyle}">
                <Grid Width="140" Height="140">
                    <Border CornerRadius="9" Background="{StaticResource RaisedBrush}"/>
                    <Border CornerRadius="9">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CoverArtUrl}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border x:Name="HoverOverlay" CornerRadius="9" Background="#99000000" Opacity="0"
                            Style="{StaticResource AlbumHoverOverlayStyle}"
                            MouseLeftButtonDown="AlbumPlayOverlay_MouseLeftButtonDown">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="▶" FontSize="16" Foreground="{StaticResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Border>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,8,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                <TextBlock x:Name="CardArtistText" Text="{Binding ArtistName}" FontSize="11" Margin="2,2,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"
                           Style="{StaticResource ClickableTextStyle}"
                           TextTrimming="CharacterEllipsis" MaxWidth="140"
                           MouseLeftButtonDown="CardArtistText_MouseLeftButtonDown" ToolTip="Go to artist"/>
            </StackPanel>
        </DataTemplate>

        <!-- Row container for AllAlbumsList: plain passthrough, no selection/hover chrome of its own
             (each row is one "item" of the outer virtualizing ListBox; the individual cards inside
             handle their own hover state). -->
        <Style x:Key="AlbumRowContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Click-anywhere-on-the-card-to-open-the-album, for AlbumCardTemplate/LargeAlbumCardTemplate
             used directly in a plain ItemsControl (Home's rows) - the nested-in-ListBox-row cases
             (AllAlbumsList, GenreAlbumsList, artist discography) set the same EventSetter inline on
             their own per-row ItemsControl instead, since ItemContainerStyle can't be shared between
             different ItemsControl instances without also sharing unrelated per-row context. -->
        <Style x:Key="AlbumCardContainerStyle" TargetType="ContentPresenter">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AlbumCard_PreviewMouseLeftButtonDown"/>
        </Style>

        <!-- Genre tile on Home: brightens and scales up slightly on hover, direct IsMouseOver
             trigger since the Border itself is the container (no ancestor-lookup indirection
             needed like the album cards). -->
        <Style x:Key="GenreCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.03" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.03" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small dark circular icon button, used for the hero carousel's prev/next arrows.
             Scales up slightly on hover and dips on press for tactile feedback. -->
        <Style x:Key="HeroNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="36" Height="36" CornerRadius="18" Background="#66000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#99000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Full song context menu: within one album's track list -->
        <ContextMenu x:Key="AlbumSongContextMenu" Opened="SongContextMenu_Opened">
            <MenuItem Header="Play now" Click="PlayNowMenuItem_Click"/>
            <MenuItem Header="Play next" Click="PlayNextMenuItem_Click"/>
            <MenuItem Header="Add to queue" Click="AddToQueueMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Add to playlist" SubmenuOpened="AddToPlaylistSubmenu_SubmenuOpened">
                <MenuItem Header="Loading..."/>
            </MenuItem>
            <MenuItem Tag="FavoriteToggle" Click="FavoriteMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Add album to queue" Click="AddAlbumToQueueMenuItem_Click"/>
        </ContextMenu>

        <!-- Song context menu for library-wide lists (no "current album" concept) -->
        <ContextMenu x:Key="LibrarySongContextMenu" Opened="SongContextMenu_Opened">
            <MenuItem Header="Play now" Click="PlayNowMenuItem_Click"/>
            <MenuItem Header="Play next" Click="PlayNextMenuItem_Click"/>
            <MenuItem Header="Add to queue" Click="AddToQueueMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Add to playlist" SubmenuOpened="AddToPlaylistSubmenu_SubmenuOpened">
                <MenuItem Header="Loading..."/>
            </MenuItem>
            <MenuItem Tag="FavoriteToggle" Click="FavoriteMenuItem_Click"/>
        </ContextMenu>

        <!-- Song context menu within a playlist's track list -->
        <ContextMenu x:Key="PlaylistSongContextMenu" Opened="SongContextMenu_Opened">
            <MenuItem Header="Play now" Click="PlayNowMenuItem_Click"/>
            <MenuItem Header="Play next" Click="PlayNextMenuItem_Click"/>
            <MenuItem Header="Add to queue" Click="AddToQueueMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Add to playlist" SubmenuOpened="AddToPlaylistSubmenu_SubmenuOpened">
                <MenuItem Header="Loading..."/>
            </MenuItem>
            <MenuItem Tag="FavoriteToggle" Click="FavoriteMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Remove from playlist" Click="RemoveFromPlaylistMenuItem_Click"/>
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,12">
            <!-- Sidebar + main content: always fills the full width now, doesn't get squeezed
                 by the Queue/Lyrics/Visualizer panel, which floats over it instead (see below). -->
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MUSICPLAYER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="8,4,0,24"/>
                    <RadioButton x:Name="NavHome" Content="Home" Tag="Home" GroupName="MainNav"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavArtists" Content="Artists" Tag="Artists" GroupName="MainNav"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAlbums" Content="Albums" Tag="Albums" GroupName="MainNav"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSongs" Content="Tracks" Tag="Songs" GroupName="MainNav"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                    <Grid Margin="8,24,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PLAYLISTS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <Button Grid.Column="1" Content="+" Width="20" Height="20" Padding="0" FontSize="13"
                                Click="NewPlaylistButton_Click" ToolTip="New playlist"/>
                    </Grid>
                </StackPanel>
                <!-- Individual playlists listed directly in the sidebar as their own nav items, not a separate page -->
                <ListBox x:Name="PlaylistsList" ItemContainerStyle="{StaticResource PlaylistListBoxItemStyle}"
                         SelectionChanged="PlaylistsList_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete playlist" Click="DeletePlaylistMenuItem_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="36" Height="36" Margin="0,0,10,0">
                                    <Border CornerRadius="5" Background="{StaticResource RaisedBrush}"/>
                                    <Border CornerRadius="5">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverArtUrl}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Page host: Home / Artists / Albums / Songs overlap the same cell, one visible at a time -->
            <Grid Grid.Column="2">

                <!-- Home: Feishin-style stack of horizontally-scrolling carousel rows -->
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,8">

                        <!-- Hero: one featured album at a time, blurred-backdrop banner with a
                             carousel to step through a handful of random picks (Feishin's Home top bar). -->
                        <Border x:Name="HomeHeroCard" Height="232" Margin="0,0,16,28" CornerRadius="14"
                                Background="{StaticResource RaisedBrush}" Visibility="Collapsed">
                            <Grid>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush x:Name="HeroBackdropBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <BlurEffect Radius="50"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="14" Background="#B3141517"/>

                                <Grid Margin="58,28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="176" Height="176" VerticalAlignment="Center" Cursor="Hand"
                                          MouseLeftButtonDown="HeroPlayOverlay_MouseLeftButtonDown">
                                        <Border CornerRadius="10" Background="{StaticResource RaisedBrush}"/>
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="HeroPlayOverlay" CornerRadius="10" Background="#66000000" Opacity="0"
                                                Style="{StaticResource AlbumHoverOverlayStyle}">
                                            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="20" Foreground="{StaticResource OnAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Border>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                                        <TextBlock x:Name="HeroTitleText" FontSize="30" FontWeight="Bold" Cursor="Hand"
                                                   Style="{StaticResource ClickableTextStyle}"
                                                   TextTrimming="CharacterEllipsis" Foreground="White"
                                                   MouseLeftButtonDown="HeroTitleText_MouseLeftButtonDown" ToolTip="Go to album"/>
                                        <TextBlock x:Name="HeroArtistText" FontSize="16" Margin="0,6,0,0" Cursor="Hand"
                                                   Style="{StaticResource ClickableTextStyle}"
                                                   Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis"
                                                   MouseLeftButtonDown="HeroArtistText_MouseLeftButtonDown" ToolTip="Go to artist"/>
                                        <TextBlock x:Name="HeroMetaText" FontSize="13" Margin="0,10,0,0" Foreground="#AAFFFFFF"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="‹" Style="{StaticResource HeroNavButtonStyle}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="HeroPrevButton_Click"/>
                                <Button Content="›" Style="{StaticResource HeroNavButtonStyle}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Click="HeroNextButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Recently played -->
                        <StackPanel x:Name="HomeRecentlyPlayedSection" Margin="0,0,0,28">
                            <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="HorizontalCarousel_PreviewMouseWheel">
                                <ItemsControl x:Name="HomeRecentlyPlayedList" ItemTemplate="{StaticResource AlbumCardTemplate}"
                                              ItemContainerStyle="{StaticResource AlbumCardContainerStyle}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Most played -->
                        <StackPanel x:Name="HomeMostPlayedSection" Margin="0,0,0,28">
                            <TextBlock Text="MOST PLAYED" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="HorizontalCarousel_PreviewMouseWheel">
                                <ItemsControl x:Name="HomeMostPlayedList" ItemTemplate="{StaticResource AlbumCardTemplate}"
                                              ItemContainerStyle="{StaticResource AlbumCardContainerStyle}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Recently added -->
                        <StackPanel x:Name="HomeRecentlyAddedSection" Margin="0,0,0,28">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RECENTLY ADDED" Style="{StaticResource SectionHeaderStyle}"/>
                                <Button Grid.Column="1" Content="More ›" Click="HomeMoreAlbumsButton_Click"
                                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="0" Padding="4,0" Cursor="Hand"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="HorizontalCarousel_PreviewMouseWheel">
                                <ItemsControl x:Name="HomeAlbumsList" ItemTemplate="{StaticResource AlbumCardTemplate}"
                                              ItemContainerStyle="{StaticResource AlbumCardContainerStyle}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Explore: random albums, a different set than the feature row -->
                        <StackPanel x:Name="HomeExploreSection" Margin="0,0,0,28">
                            <TextBlock Text="EXPLORE" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="HorizontalCarousel_PreviewMouseWheel">
                                <ItemsControl x:Name="HomeExploreList" ItemTemplate="{StaticResource AlbumCardTemplate}"
                                              ItemContainerStyle="{StaticResource AlbumCardContainerStyle}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Featured genres -->
                        <StackPanel x:Name="HomeGenresSection" Margin="0,0,0,28">
                            <TextBlock Text="FEATURED GENRES" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="HorizontalCarousel_PreviewMouseWheel">
                                <ItemsControl x:Name="HomeGenresList" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="168" Height="92" Margin="0,0,12,0" CornerRadius="8"
                                                    Background="{StaticResource RaisedBrush}" Cursor="Hand"
                                                    MouseLeftButtonDown="GenreCard_MouseLeftButtonDown"
                                                    Style="{StaticResource GenreCardStyle}">
                                                <StackPanel VerticalAlignment="Center" Margin="14,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding AlbumCount, StringFormat={}{0} albums}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Playlists -->
                        <StackPanel x:Name="HomePlaylistsSection" Margin="0,0,0,10">
                            <TextBlock Text="PLAYLISTS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="HorizontalCarousel_PreviewMouseWheel">
                                <ItemsControl x:Name="HomePlaylistsList" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="112" Margin="2,4" Cursor="Hand"
                                                        MouseLeftButtonDown="HomePlaylistCard_MouseLeftButtonDown">
                                                <Grid Width="104" Height="104">
                                                    <Border CornerRadius="8" Background="{StaticResource RaisedBrush}"/>
                                                    <Border CornerRadius="8">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding CoverArtUrl}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,6,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="104"/>
                                                <TextBlock Text="{Binding SongCount, StringFormat={}{0} tracks}" FontSize="11" Margin="2,1,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Artists: full-width list, clicking one opens ArtistDetailPage below -->
                <DockPanel x:Name="ArtistsPage" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ARTISTS" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,10,0"/>
                        <TextBox x:Name="ArtistSearchBox" Grid.Column="2" Tag="Search"
                                 TextChanged="ArtistSearchBox_TextChanged"/>
                    </Grid>
                    <ListBox x:Name="ArtistsList" DisplayMemberPath="Name"
                             SelectionChanged="ArtistsList_SelectionChanged"/>
                </DockPanel>

                <!-- Artist detail (Feishin-style): blurred-backdrop header with photo/name/stats/
                     play-shuffle-favorite, then discography below; clicking an album swaps the
                     discography grid for that album's track list. -->
                <Grid x:Name="ArtistDetailPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="220" Margin="0,0,16,20" CornerRadius="14"
                            Background="{StaticResource RaisedBrush}">
                        <Grid>
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <ImageBrush x:Name="ArtistHeaderBackdropBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="50"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="14" Background="#B3141517"/>

                            <Grid Margin="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="164" Height="164" VerticalAlignment="Center">
                                    <Border CornerRadius="82" Background="{StaticResource RaisedBrush}"/>
                                    <Border CornerRadius="82">
                                        <Border.Background>
                                            <ImageBrush x:Name="ArtistHeaderArtBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                                    <TextBlock x:Name="ArtistHeaderNameText" FontSize="28" FontWeight="Bold"
                                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ArtistHeaderStatsText" FontSize="13" Margin="0,8,0,0" Foreground="#AAFFFFFF"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button x:Name="ArtistHeaderPlayButton" Width="40" Height="40"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ArtistHeaderPlayButton_Click" ToolTip="Play">
                                            <Polygon Points="1,0 13,7 1,14" Fill="{StaticResource OnAccentBrush}"/>
                                        </Button>
                                        <Button x:Name="ArtistHeaderShuffleButton" Width="40" Height="40" Margin="10,0,0,0"
                                                Background="#33FFFFFF" Click="ArtistHeaderShuffleButton_Click" ToolTip="Shuffle">
                                            <Path Width="16" Height="14" Stretch="Uniform"
                                                  Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M1,4 L6,4 L15,13 M11,13 L15,13 L15,9 M1,12 L6,12 L15,3 M11,3 L15,3 L15,7"/>
                                        </Button>
                                        <Button x:Name="ArtistFavoriteButton" Width="40" Height="40" Margin="10,0,0,0"
                                                Background="#33FFFFFF" Click="ArtistFavoriteButton_Click" ToolTip="Favorite">
                                            <Path x:Name="ArtistFavoriteIcon" Width="17" Height="16" Stretch="Uniform"
                                                  Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                                                  Data="M8,15 C8,15 1,10.5 1,5.8 C1,3 3,1.3 5.4,1.3 C6.9,1.3 7.7,2.1 8,2.6
                                                        C8.3,2.1 9.1,1.3 10.6,1.3 C13,1.3 15,3 15,5.8 C15,10.5 8,15 8,15 Z"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <DockPanel x:Name="ArtistDiscographyView">
                            <TextBlock DockPanel.Dock="Top" Text="DISCOGRAPHY" Style="{StaticResource SectionHeaderStyle}"/>
                            <!-- Row-chunked like AllAlbumsList (see there for why): only visible rows
                                 get realized/fetch cover art, instead of every album for this artist at once. -->
                            <ListBox x:Name="AlbumsList" ItemContainerStyle="{StaticResource AlbumRowContainerStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SizeChanged="AlbumsList_SizeChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource AlbumCardTemplate}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AlbumCard_PreviewMouseLeftButtonDown"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <DockPanel x:Name="ArtistAlbumTracksView" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Width="30" Height="30" Margin="0,0,10,0" Click="BackToDiscographyButton_Click" ToolTip="Back">
                                        <Canvas Width="12" Height="12">
                                            <Rectangle Canvas.Left="10" Width="2" Height="12" Fill="{StaticResource TextPrimaryBrush}"/>
                                            <Polygon Points="8,0 0,6 8,12" Fill="{StaticResource TextPrimaryBrush}"/>
                                        </Canvas>
                                    </Button>
                                    <Button x:Name="AlbumPlayButton" Content="▶" Width="30" Height="30" FontSize="12"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                                            Click="SortButton_Click" ToolTip="Play">
                                        <Button.ContextMenu>
                                            <ContextMenu Placement="Bottom">
                                                <MenuItem Header="Play" Tag="AlbumTracks" Click="PlayMenuItem_Click"/>
                                                <MenuItem Header="Shuffle" Tag="AlbumTracks" Click="ShuffleMenuItem_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <TextBlock x:Name="ArtistAlbumTracksHeader" Text="TRACKS" Style="{StaticResource SectionHeaderStyle}"
                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="AlbumTrackSearchBox" Grid.Column="2" Tag="Search"
                                         TextChanged="AlbumTrackSearchBox_TextChanged"/>
                            </Grid>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="AlbumTrackSortButton" Content="Sort ▾" Tag="AlbumTracks" Padding="14,6"
                                            Click="SortButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu Placement="Bottom">
                                                <MenuItem Header="Album" IsCheckable="True" Tag="Album" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Album Artist" IsCheckable="True" Tag="AlbumArtist" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Artist" IsCheckable="True" Tag="Artist" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Duration" IsCheckable="True" Tag="Duration" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Is favorited" IsCheckable="True" Tag="Favorited" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Genre" IsCheckable="True" Tag="Genre" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Name" IsCheckable="True" Tag="Name" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Play count" IsCheckable="True" Tag="PlayCount" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Random" IsCheckable="True" Tag="Random" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Recently added" IsCheckable="True" Tag="RecentlyAdded" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Recently played" IsCheckable="True" Tag="RecentlyPlayed" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Release year" IsCheckable="True" Tag="ReleaseYear" Click="SortMenuItem_Click"/>
                                                <MenuItem Header="Year" IsCheckable="True" Tag="Year" Click="SortMenuItem_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="AlbumTrackSortDirectionButton" Content="↑" Tag="AlbumTracks" Width="34" Height="34"
                                            Margin="8,0,0,0" ToolTip="Toggle ascending/descending" Click="SortDirectionButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="SongsList" MouseDoubleClick="SongsList_MouseDoubleClick"
                                      ItemContainerStyle="{StaticResource LocalTrackListViewItemStyle}"
                                      ContextMenu="{StaticResource AlbumSongContextMenu}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="TITLE" Width="270" CellTemplate="{StaticResource TrackTitleCellTemplate}"/>
                                        <GridViewColumn Header="TIME" Width="64" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                        <GridViewColumn Header="GENRE" Width="140" DisplayMemberBinding="{Binding Genre}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- Albums: whole-library album grid -->
                <DockPanel x:Name="AlbumsPage" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ALL ALBUMS" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,10,0"/>
                        <TextBox x:Name="AllAlbumsSearchBox" Grid.Column="2" Tag="Search"
                                 TextChanged="AllAlbumsSearchBox_TextChanged"/>
                    </Grid>
                    <!-- Rows of albums rather than one flat WrapPanel: ListBox's default panel
                         (VirtualizingStackPanel) then only realizes rows actually on screen, instead
                         of building all (up to 500) cards - and firing 500 cover-art requests - at once. -->
                    <ListBox x:Name="AllAlbumsList" ItemContainerStyle="{StaticResource AlbumRowContainerStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SizeChanged="AllAlbumsList_SizeChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource LargeAlbumCardTemplate}"
                                              ItemContainerStyle="{StaticResource AlbumCardContainerStyle}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Songs: whole-library track list -->
                <DockPanel x:Name="SongsPage" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="AllTracksPlayButton" Content="▶" Width="30" Height="30" FontSize="12"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                                    Click="SortButton_Click" ToolTip="Play">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="Play" Tag="AllTracks" Click="PlayMenuItem_Click"/>
                                        <MenuItem Header="Shuffle" Tag="AllTracks" Click="ShuffleMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock Text="ALL TRACKS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="AllTracksSearchBox" Grid.Column="2" Tag="Search"
                                 TextChanged="AllTracksSearchBox_TextChanged"/>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="AllTracksSortButton" Content="Sort ▾" Tag="AllTracks" Padding="14,6"
                                    Click="SortButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="Album" IsCheckable="True" Tag="Album" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Album Artist" IsCheckable="True" Tag="AlbumArtist" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Artist" IsCheckable="True" Tag="Artist" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Duration" IsCheckable="True" Tag="Duration" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Is favorited" IsCheckable="True" Tag="Favorited" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Genre" IsCheckable="True" Tag="Genre" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Name" IsCheckable="True" Tag="Name" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Play count" IsCheckable="True" Tag="PlayCount" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Random" IsCheckable="True" Tag="Random" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Recently added" IsCheckable="True" Tag="RecentlyAdded" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Recently played" IsCheckable="True" Tag="RecentlyPlayed" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Release year" IsCheckable="True" Tag="ReleaseYear" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Year" IsCheckable="True" Tag="Year" Click="SortMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="AllTracksSortDirectionButton" Content="↑" Tag="AllTracks" Width="34" Height="34"
                                    Margin="8,0,0,0" ToolTip="Toggle ascending/descending" Click="SortDirectionButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="AllSongsList" MouseDoubleClick="AllSongsList_MouseDoubleClick"
                              ItemContainerStyle="{StaticResource LocalTrackListViewItemStyle}"
                              ContextMenu="{StaticResource LibrarySongContextMenu}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="TITLE" Width="290" CellTemplate="{StaticResource TrackTitleCellTemplate}"/>
                                <GridViewColumn Header="TIME" Width="64" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                <GridViewColumn Header="GENRE" Width="140" DisplayMemberBinding="{Binding Genre}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <!-- Genre detail: albums within a single genre, opened from Home's "Featured Genres" row -->
                <DockPanel x:Name="GenreAlbumsPage" Visibility="Collapsed">
                    <TextBlock x:Name="GenreAlbumsHeader" DockPanel.Dock="Top" Text="GENRE"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                    <ListBox x:Name="GenreAlbumsList" ItemContainerStyle="{StaticResource AlbumRowContainerStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SizeChanged="GenreAlbumsList_SizeChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource LargeAlbumCardTemplate}"
                                              ItemContainerStyle="{StaticResource AlbumCardContainerStyle}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Playlist detail: tracks of whichever playlist is selected in the sidebar -->
                <DockPanel x:Name="PlaylistsPage" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Grid Width="44" Height="44" Margin="2,0,10,0">
                                <Border CornerRadius="6" Background="{StaticResource RaisedBrush}"/>
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush x:Name="PlaylistHeaderArtBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="PlaylistTracksHeader" Text="PLAYLIST" Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button x:Name="PlaylistPlayButton" Content="▶" Width="30" Height="30" FontSize="12"
                                    Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                                    Click="SortButton_Click" ToolTip="Play">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="Play" Tag="PlaylistTracks" Click="PlayMenuItem_Click"/>
                                        <MenuItem Header="Shuffle" Tag="PlaylistTracks" Click="ShuffleMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="PlaylistTrackSearchBox" Grid.Column="2" Tag="Search"
                                 TextChanged="PlaylistTrackSearchBox_TextChanged"/>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="PlaylistTrackSortButton" Content="Sort ▾" Tag="PlaylistTracks" Padding="14,6"
                                    Click="SortButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="Album" IsCheckable="True" Tag="Album" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Album Artist" IsCheckable="True" Tag="AlbumArtist" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Artist" IsCheckable="True" Tag="Artist" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Duration" IsCheckable="True" Tag="Duration" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Is favorited" IsCheckable="True" Tag="Favorited" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Genre" IsCheckable="True" Tag="Genre" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Name" IsCheckable="True" Tag="Name" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Play count" IsCheckable="True" Tag="PlayCount" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Random" IsCheckable="True" Tag="Random" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Recently added" IsCheckable="True" Tag="RecentlyAdded" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Recently played" IsCheckable="True" Tag="RecentlyPlayed" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Release year" IsCheckable="True" Tag="ReleaseYear" Click="SortMenuItem_Click"/>
                                        <MenuItem Header="Year" IsCheckable="True" Tag="Year" Click="SortMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="PlaylistTrackSortDirectionButton" Content="↑" Tag="PlaylistTracks" Width="34" Height="34"
                                    Margin="8,0,0,0" ToolTip="Toggle ascending/descending" Click="SortDirectionButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="PlaylistSongsList" MouseDoubleClick="PlaylistSongsList_MouseDoubleClick"
                              ItemContainerStyle="{StaticResource LocalTrackListViewItemStyle}"
                              ContextMenu="{StaticResource PlaylistSongContextMenu}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="TITLE" Width="290" CellTemplate="{StaticResource TrackTitleCellTemplate}"/>
                                <GridViewColumn Header="TIME" Width="64" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                <GridViewColumn Header="GENRE" Width="140" DisplayMemberBinding="{Binding Genre}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
            </Grid>

            <!-- Full screen player: click the now-playing title to open. Left half is art/title/
                 artist, right half switches between Queue/Lyrics/Visualizer via a tab bar - this is
                 Feishin's actual full-screen-player layout (its CSS splits into two 50% columns). -->
            <Grid x:Name="FullScreenPlayerOverlay" Background="{StaticResource BackgroundBrush}" Visibility="Collapsed">
                <Button Content="✕" Width="34" Height="34" FontSize="13" Margin="24"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="CloseFullScreenPlayer_Click" ToolTip="Close" Panel.ZIndex="1"/>

                <Grid Margin="80,40,80,60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: album art, title, artist -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="360" Height="360">
                            <Border CornerRadius="12" Background="{StaticResource RaisedBrush}"/>
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <ImageBrush x:Name="FullScreenArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="FullScreenTitleText" FontSize="24" FontWeight="Bold" Margin="0,28,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                        <TextBlock x:Name="FullScreenArtistText" FontSize="16" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"
                                   Style="{StaticResource ClickableTextStyle}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"
                                   MouseLeftButtonDown="NowPlayingArtist_MouseLeftButtonDown"
                                   ToolTip="Go to artist"/>
                    </StackPanel>

                    <!-- Right: Queue / Lyrics / Visualizer behind a persistent tab bar -->
                    <DockPanel Grid.Column="2">
                        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,16">
                            <RadioButton x:Name="QueueTabButton" Content="Queue" Tag="Queue" GroupName="SidePanelTabs"
                                         Style="{StaticResource SidePanelTabStyle}" Checked="SidePanelTabButton_Checked"/>
                            <RadioButton x:Name="LyricsTabButton" Content="Lyrics" Tag="Lyrics" GroupName="SidePanelTabs"
                                         Style="{StaticResource SidePanelTabStyle}" Checked="SidePanelTabButton_Checked"/>
                            <RadioButton x:Name="VisualizerTabButton" Content="Visualizer" Tag="Visualizer" GroupName="SidePanelTabs"
                                         Style="{StaticResource SidePanelTabStyle}" Checked="SidePanelTabButton_Checked"/>
                        </UniformGrid>
                        <Grid>
                            <DockPanel x:Name="QueuePanelView">
                                <ListBox x:Name="QueueList" MouseDoubleClick="QueueList_MouseDoubleClick">
                                    <ListBox.ContextMenu>
                                        <ContextMenu Opened="SongContextMenu_Opened">
                                            <MenuItem Header="Add to playlist" SubmenuOpened="AddToPlaylistSubmenu_SubmenuOpened">
                                                <MenuItem Header="Loading..."/>
                                            </MenuItem>
                                            <MenuItem Tag="FavoriteToggle" Click="FavoriteMenuItem_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Remove from queue" Click="RemoveFromQueueMenuItem_Click"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                                <Grid Width="36" Height="36" Margin="0,0,10,0">
                                                    <Border CornerRadius="4" Background="{StaticResource RaisedBrush}"/>
                                                    <Border CornerRadius="4">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding CoverArtUrl}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ArtistName}" FontSize="11" Cursor="Hand"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               MouseLeftButtonDown="SongArtistText_MouseLeftButtonDown"
                                                               ToolTip="Go to artist"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <DockPanel x:Name="LyricsPanelView" Visibility="Collapsed">
                                <TextBlock x:Name="LyricsPlaceholder" Text="No lyrics found for this track." TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                <ListBox x:Name="LyricsList" MouseDoubleClick="LyricsList_MouseDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <DockPanel x:Name="VisualizerPanelView" Visibility="Collapsed">
                                <Grid x:Name="VisualizerContainer" ClipToBounds="True">
                                    <Path x:Name="VisualizerPath" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#66FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Playback bar -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Now playing info -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Grid Width="56" Height="56">
                        <Border CornerRadius="6" Background="{StaticResource RaisedBrush}"/>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush x:Name="NowPlayingArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="NowPlayingText" FontWeight="SemiBold" Cursor="Hand"
                                   Style="{StaticResource ClickableTextStyle}"
                                   Text="Nothing playing" TextTrimming="CharacterEllipsis"
                                   MouseLeftButtonDown="NowPlayingText_MouseLeftButtonDown"
                                   ToolTip="Show/hide Queue, Lyrics, Visualizer"/>
                        <TextBlock x:Name="NowPlayingSubText" FontSize="12" Cursor="Hand"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Style="{StaticResource ClickableTextStyle}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   MouseLeftButtonDown="NowPlayingArtist_MouseLeftButtonDown"
                                   ToolTip="Go to artist"/>
                    </StackPanel>
                </StackPanel>

                <!-- Transport + progress -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="StopButton" Style="{StaticResource IconButtonStyle}"
                                Click="StopButton_Click" ToolTip="Stop">
                            <Rectangle Width="12" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource TextPrimaryBrush}"/>
                        </Button>

                        <Button x:Name="ShuffleButton" Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                                Click="ShuffleButton_Click" ToolTip="Shuffle">
                            <Path x:Name="ShuffleIconPath" Width="16" Height="14" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M1,4 L6,4 L15,13 M11,13 L15,13 L15,9 M1,12 L6,12 L15,3 M11,3 L15,3 L15,7"/>
                        </Button>

                        <Button x:Name="PreviousButton" Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                                Click="PreviousButton_Click" ToolTip="Previous">
                            <Canvas Width="14" Height="14">
                                <Rectangle Width="2" Height="14" Fill="{StaticResource TextPrimaryBrush}"/>
                                <Polygon Points="12,1 4,7 12,13" Fill="{StaticResource TextPrimaryBrush}"/>
                            </Canvas>
                        </Button>

                        <Button x:Name="PlayPauseButton" Width="44" Height="44" Margin="8,0"
                                Style="{StaticResource PrimaryButtonStyle}" Click="PlayPauseButton_Click" ToolTip="Play/Pause">
                            <Grid Width="16" Height="16">
                                <Polygon x:Name="PlayIcon" Points="1,0 15,8 1,16" Fill="{StaticResource OnAccentBrush}"/>
                                <Grid x:Name="PauseIcon" Visibility="Collapsed">
                                    <Rectangle Width="4" Height="16" HorizontalAlignment="Left" Fill="{StaticResource OnAccentBrush}"/>
                                    <Rectangle Width="4" Height="16" HorizontalAlignment="Right" Fill="{StaticResource OnAccentBrush}"/>
                                </Grid>
                            </Grid>
                        </Button>

                        <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}"
                                Click="NextButton_Click" ToolTip="Next">
                            <Canvas Width="14" Height="14">
                                <Polygon Points="2,1 10,7 2,13" Fill="{StaticResource TextPrimaryBrush}"/>
                                <Rectangle Canvas.Left="12" Width="2" Height="14" Fill="{StaticResource TextPrimaryBrush}"/>
                            </Canvas>
                        </Button>

                        <Button x:Name="RepeatButton" Style="{StaticResource IconButtonStyle}" Margin="0,0,2,0"
                                Click="RepeatButton_Click" ToolTip="Repeat">
                            <Grid Width="16" Height="16">
                                <Path x:Name="RepeatIconPath" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="12,3" IsClosed="False">
                                                <ArcSegment Point="4,3" Size="6,6" SweepDirection="Clockwise" IsLargeArc="True"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <Polygon x:Name="RepeatArrowHead" Points="12,0.5 16,3 12,5.5" Fill="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="8" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="QueueToggleButton" Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                                Click="QueueToggleButton_Click" ToolTip="Queue">
                            <StackPanel VerticalAlignment="Center">
                                <Rectangle Width="16" Height="2" Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                <Rectangle Width="16" Height="2" Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                <Rectangle Width="10" Height="2" Fill="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Grid.Column="0" Text="0:00" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="10,0"
                                Minimum="0" Value="0" IsMoveToPointEnabled="True"
                                PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                                PreviewMouseUp="ProgressSlider_PreviewMouseUp"/>
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="VOL" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" Value="0.8"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      Visibility="Collapsed" MediaEnded="Player_MediaEnded" MediaOpened="Player_MediaOpened"/>
    </Grid>
</Window>
